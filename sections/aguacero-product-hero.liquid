{% assign uid = section.id %}

<style>
#agc-{{ uid }} {
  --bg: {{ section.settings.color_bg }};
  --white: {{ section.settings.color_white }};
  --dark: {{ section.settings.color_dark }};
  --accent: {{ section.settings.color_accent }};
  --pale: {{ section.settings.color_pale }};
  --text: {{ section.settings.color_text }};
  --muted: {{ section.settings.color_muted }};
  --border: {{ section.settings.color_border }};
  --ok: {{ section.settings.color_ok }};
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: var(--text);
  background: var(--bg);
}
#agc-{{ uid }} * { box-sizing: border-box; margin: 0; padding: 0; }
#agc-{{ uid }} img { max-width: 100%; display: block; }

/* Fade-in animation */
#agc-{{ uid }} .agc-fade { opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease, transform 0.6s ease; }
#agc-{{ uid }} .agc-fade.is-visible { opacity: 1; transform: translateY(0); }

/* ── ANNOUNCEMENT BAR ── */
#agc-{{ uid }} .agc-announce {
  background: var(--dark);
  color: #fff;
  padding: 10px 0;
  overflow: hidden;
  white-space: nowrap;
}
#agc-{{ uid }} .agc-marquee-track {
  display: inline-flex;
  gap: 0;
  animation: agcMarquee 28s linear infinite;
}
#agc-{{ uid }} .agc-marquee-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 32px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  white-space: nowrap;
}
#agc-{{ uid }} .agc-marquee-item::after {
  content: '★';
  color: #f5c842;
  font-size: 11px;
}
@keyframes agcMarquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ── HERO ── */
#agc-{{ uid }} .agc-hero {
  background: var(--bg);
  padding: 48px 0 64px;
}
#agc-{{ uid }} .agc-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}
#agc-{{ uid }} .agc-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: start;
}
/* Gallery */
#agc-{{ uid }} .agc-gallery { position: sticky; top: 20px; }
#agc-{{ uid }} .agc-gallery-main {
  border-radius: 20px;
  overflow: hidden;
  background: var(--pale);
  aspect-ratio: 1/1;
  position: relative;
}
#agc-{{ uid }} .agc-gallery-main img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.3s ease;
}
#agc-{{ uid }} .agc-gallery-badge {
  position: absolute;
  top: 16px;
  left: 16px;
  background: var(--accent);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 50px;
}
#agc-{{ uid }} .agc-thumbs {
  display: flex;
  gap: 10px;
  margin-top: 14px;
  flex-wrap: wrap;
}
#agc-{{ uid }} .agc-thumb {
  width: 72px;
  height: 72px;
  border-radius: 10px;
  overflow: hidden;
  border: 2px solid transparent;
  cursor: pointer;
  transition: border-color 0.2s;
  background: var(--pale);
  flex-shrink: 0;
}
#agc-{{ uid }} .agc-thumb.active,
#agc-{{ uid }} .agc-thumb:hover { border-color: var(--accent); }
#agc-{{ uid }} .agc-thumb img { width: 100%; height: 100%; object-fit: cover; }

/* Buy Box */
#agc-{{ uid }} .agc-buybox { padding-top: 8px; }
#agc-{{ uid }} .agc-tag-pill {
  display: inline-block;
  background: rgba(41,82,204,0.1);
  color: var(--accent);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 50px;
  margin-bottom: 16px;
}
#agc-{{ uid }} .agc-product-title {
  font-size: clamp(28px, 4vw, 46px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--dark);
  margin-bottom: 14px;
}
#agc-{{ uid }} .agc-product-title em {
  font-style: italic;
  color: var(--accent);
}
#agc-{{ uid }} .agc-rating {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}
#agc-{{ uid }} .agc-stars { color: #f5c842; font-size: 18px; letter-spacing: 2px; }
#agc-{{ uid }} .agc-rating-val { font-weight: 700; font-size: 15px; color: var(--dark); }
#agc-{{ uid }} .agc-rating-cnt { font-size: 13px; color: var(--muted); }
#agc-{{ uid }} .agc-tagline {
  font-size: 15px;
  color: var(--muted);
  margin-bottom: 28px;
  line-height: 1.6;
}
/* Tier selector */
#agc-{{ uid }} .agc-tier-label {
  font-size: 13px;
  font-weight: 700;
  color: var(--dark);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 12px;
}
#agc-{{ uid }} .agc-tiers { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
#agc-{{ uid }} .agc-tier-card {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 14px;
  border: 2px solid var(--border);
  border-radius: 14px;
  padding: 14px 16px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  background: var(--white);
  position: relative;
}
#agc-{{ uid }} .agc-tier-card:hover { border-color: var(--accent); }
#agc-{{ uid }} .agc-tier-card.selected {
  border-color: var(--accent);
  background: rgba(41,82,204,0.04);
}
#agc-{{ uid }} .agc-tier-radio {
  width: 20px; height: 20px;
  border: 2px solid var(--border);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: border-color 0.2s;
}
#agc-{{ uid }} .agc-tier-card.selected .agc-tier-radio {
  border-color: var(--accent);
  background: var(--accent);
}
#agc-{{ uid }} .agc-tier-card.selected .agc-tier-radio::after {
  content: '';
  width: 8px; height: 8px;
  background: white;
  border-radius: 50%;
}
#agc-{{ uid }} .agc-tier-info {}
#agc-{{ uid }} .agc-tier-name { font-weight: 700; font-size: 15px; color: var(--dark); }
#agc-{{ uid }} .agc-tier-unit { font-size: 12px; color: var(--muted); }
#agc-{{ uid }} .agc-tier-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
#agc-{{ uid }} .agc-tier-price { text-align: right; }
#agc-{{ uid }} .agc-tier-amount { font-size: 18px; font-weight: 800; color: var(--dark); }
#agc-{{ uid }} .agc-tier-badge {
  position: absolute;
  top: -10px; right: 14px;
  background: var(--ok);
  color: white;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 3px 10px;
  border-radius: 50px;
}
#agc-{{ uid }} .agc-tier-savings {
  font-size: 11px;
  color: var(--ok);
  font-weight: 600;
  margin-top: 2px;
}
/* Qty */
#agc-{{ uid }} .agc-qty-row {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 18px;
}
#agc-{{ uid }} .agc-qty-label { font-size: 13px; font-weight: 700; color: var(--dark); text-transform: uppercase; letter-spacing: 0.1em; }
#agc-{{ uid }} .agc-qty-ctrl {
  display: flex;
  align-items: center;
  border: 2px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
}
#agc-{{ uid }} .agc-qty-btn {
  width: 38px; height: 38px;
  background: none; border: none;
  font-size: 20px; cursor: pointer;
  color: var(--dark);
  display: flex; align-items: center; justify-content: center;
  transition: background 0.15s;
}
#agc-{{ uid }} .agc-qty-btn:hover { background: var(--pale); }
#agc-{{ uid }} .agc-qty-val {
  min-width: 38px; text-align: center;
  font-weight: 700; font-size: 16px;
  color: var(--dark);
}
/* CTA */
#agc-{{ uid }} .agc-atc-btn {
  width: 100%;
  padding: 18px 32px;
  background: var(--dark);
  color: white;
  border: none;
  border-radius: 50px;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 0.02em;
  cursor: pointer;
  transition: background 0.2s, transform 0.1s;
  margin-bottom: 14px;
}
#agc-{{ uid }} .agc-atc-btn:hover { background: var(--accent); }
#agc-{{ uid }} .agc-atc-btn:active { transform: scale(0.98); }
#agc-{{ uid }} .agc-delivery {
  text-align: center;
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 20px;
}
#agc-{{ uid }} .agc-delivery strong { color: var(--dark); }
/* Urgency */
#agc-{{ uid }} .agc-urgency {
  background: var(--pale);
  border-radius: 12px;
  padding: 14px 18px;
  margin-bottom: 20px;
}
#agc-{{ uid }} .agc-urgency-head {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  font-weight: 700;
  color: var(--dark);
  margin-bottom: 8px;
}
#agc-{{ uid }} .agc-urgency-bar-outer {
  background: var(--border);
  border-radius: 50px;
  height: 8px;
  overflow: hidden;
  margin-bottom: 6px;
}
#agc-{{ uid }} .agc-urgency-bar-inner {
  height: 100%;
  background: var(--ok);
  border-radius: 50px;
  transition: width 1s ease;
}
#agc-{{ uid }} .agc-urgency-note { font-size: 12px; color: var(--muted); }
/* Trust badges */
#agc-{{ uid }} .agc-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
}
#agc-{{ uid }} .agc-badge {
  display: flex;
  align-items: center;
  gap: 7px;
  background: var(--pale);
  border-radius: 10px;
  padding: 9px 14px;
  font-size: 12px;
  font-weight: 600;
  color: var(--dark);
  flex: 1 1 calc(50% - 5px);
}
#agc-{{ uid }} .agc-badge-icon { font-size: 18px; }
/* Timeline */
#agc-{{ uid }} .agc-timeline-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--accent);
  margin-bottom: 12px;
}
#agc-{{ uid }} .agc-timeline { display: flex; flex-direction: column; gap: 0; margin-bottom: 20px; }
#agc-{{ uid }} .agc-tl-item {
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 12px;
  align-items: start;
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
}
#agc-{{ uid }} .agc-tl-item:last-child { border-bottom: none; }
#agc-{{ uid }} .agc-tl-week {
  font-size: 12px;
  font-weight: 700;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
#agc-{{ uid }} .agc-tl-desc { font-size: 13px; color: var(--muted); line-height: 1.5; }
/* Payment logos */
#agc-{{ uid }} .agc-pay-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--muted);
  text-align: center;
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
#agc-{{ uid }} .agc-pay-logos {
  display: flex;
  gap: 8px;
  justify-content: center;
  flex-wrap: wrap;
  align-items: center;
}
#agc-{{ uid }} .agc-pay-logo {
  height: 28px;
  opacity: 0.6;
  object-fit: contain;
}
#agc-{{ uid }} .agc-pay-pill {
  background: var(--pale);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 12px;
  font-weight: 700;
  color: var(--muted);
}

/* ── UGC MASONRY ── */
#agc-{{ uid }} .agc-ugc {
  background: var(--white);
  padding: 80px 0;
}
#agc-{{ uid }} .agc-section-eyebrow {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--accent);
  text-align: center;
  margin-bottom: 10px;
}
#agc-{{ uid }} .agc-section-title {
  font-size: clamp(32px, 5vw, 52px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--dark);
  text-align: center;
  margin-bottom: 48px;
}
#agc-{{ uid }} .agc-masonry {
  columns: 4;
  column-gap: 14px;
}
#agc-{{ uid }} .agc-ugc-card {
  break-inside: avoid;
  margin-bottom: 14px;
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  cursor: pointer;
  background: var(--pale);
}
#agc-{{ uid }} .agc-ugc-card img {
  width: 100%;
  display: block;
  transition: transform 0.4s ease;
}
#agc-{{ uid }} .agc-ugc-card:hover img { transform: scale(1.04); }
#agc-{{ uid }} .agc-ugc-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(26,16,54,0.9) 0%, transparent 50%);
  opacity: 0;
  transition: opacity 0.3s ease;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 20px;
}
#agc-{{ uid }} .agc-ugc-card:hover .agc-ugc-overlay { opacity: 1; }
#agc-{{ uid }} .agc-ugc-stars { color: #f5c842; font-size: 13px; margin-bottom: 6px; }
#agc-{{ uid }} .agc-ugc-quote { font-size: 13px; color: white; line-height: 1.4; margin-bottom: 6px; }
#agc-{{ uid }} .agc-ugc-author { font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.7); }
#agc-{{ uid }} .agc-ugc-hidden { display: none; }
#agc-{{ uid }} .agc-show-more {
  display: block;
  margin: 32px auto 0;
  padding: 14px 40px;
  background: var(--dark);
  color: white;
  border: none;
  border-radius: 50px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s;
}
#agc-{{ uid }} .agc-show-more:hover { background: var(--accent); }

/* ── BENEFITS ── */
#agc-{{ uid }} .agc-benefits {
  background: var(--pale);
  padding: 80px 0;
}
#agc-{{ uid }} .agc-bens-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 48px;
}
#agc-{{ uid }} .agc-ben-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  transition: box-shadow 0.2s, transform 0.2s;
}
#agc-{{ uid }} .agc-ben-card:hover {
  box-shadow: 0 12px 40px rgba(26,16,54,0.12);
  transform: translateY(-4px);
}
#agc-{{ uid }} .agc-ben-img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  display: block;
}
#agc-{{ uid }} .agc-ben-body { padding: 22px; }
#agc-{{ uid }} .agc-ben-emoji { font-size: 28px; margin-bottom: 8px; display: block; }
#agc-{{ uid }} .agc-ben-title { font-size: 18px; font-weight: 700; color: var(--dark); margin-bottom: 6px; }
#agc-{{ uid }} .agc-ben-desc { font-size: 14px; color: var(--muted); line-height: 1.5; margin-bottom: 12px; }
#agc-{{ uid }} .agc-ben-stat { font-size: 28px; font-weight: 800; color: var(--accent); line-height: 1; }
#agc-{{ uid }} .agc-ben-stat-label { font-size: 12px; color: var(--muted); margin-top: 2px; }

/* ── MEDIA MARQUEE ── */
#agc-{{ uid }} .agc-media-marquee {
  background: var(--dark);
  padding: 20px 0;
  overflow: hidden;
}
#agc-{{ uid }} .agc-media-track {
  display: inline-flex;
  gap: 0;
  animation: agcMarquee 22s linear infinite;
}
#agc-{{ uid }} .agc-media-item {
  display: inline-flex;
  align-items: center;
  padding: 0 40px;
  font-size: 18px;
  font-weight: 800;
  color: rgba(255,255,255,0.5);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  white-space: nowrap;
}
#agc-{{ uid }} .agc-media-item img {
  height: 36px;
  object-fit: contain;
  filter: brightness(0) invert(1);
  opacity: 0.5;
}

/* ── PROBLEM SECTION ── */
#agc-{{ uid }} .agc-problem {
  background: var(--dark);
  padding: 80px 0;
  color: white;
}
#agc-{{ uid }} .agc-prob-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
#agc-{{ uid }} .agc-prob-img {
  border-radius: 20px;
  overflow: hidden;
  aspect-ratio: 4/5;
}
#agc-{{ uid }} .agc-prob-img img { width: 100%; height: 100%; object-fit: cover; }
#agc-{{ uid }} .agc-prob-eyebrow {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--accent);
  margin-bottom: 14px;
}
#agc-{{ uid }} .agc-prob-title {
  font-size: clamp(28px, 4vw, 46px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: white;
  margin-bottom: 18px;
}
#agc-{{ uid }} .agc-prob-intro { font-size: 16px; color: rgba(255,255,255,0.7); line-height: 1.6; margin-bottom: 36px; }
#agc-{{ uid }} .agc-prob-stats { display: flex; flex-direction: column; gap: 24px; }
#agc-{{ uid }} .agc-prob-stat {}
#agc-{{ uid }} .agc-prob-num {
  font-size: 52px;
  font-weight: 800;
  line-height: 1;
  color: var(--accent);
  margin-bottom: 4px;
}
#agc-{{ uid }} .agc-prob-label { font-size: 15px; color: rgba(255,255,255,0.7); line-height: 1.4; }

/* ── FILTRATION / CIRCULAR STATS ── */
#agc-{{ uid }} .agc-filtration {
  background: var(--accent);
  padding: 80px 0;
}
#agc-{{ uid }} .agc-filtration .agc-section-eyebrow { color: rgba(255,255,255,0.7); }
#agc-{{ uid }} .agc-filtration .agc-section-title { color: white; }
#agc-{{ uid }} .agc-rings-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
  margin-top: 48px;
}
#agc-{{ uid }} .agc-ring-wrap { text-align: center; }
#agc-{{ uid }} .agc-ring { position: relative; display: inline-block; }
#agc-{{ uid }} .agc-ring-num {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 800;
  color: white;
}
#agc-{{ uid }} .agc-ring-label {
  font-size: 16px;
  font-weight: 700;
  color: white;
  margin-top: 16px;
}
#agc-{{ uid }} .agc-ring-sublabel { font-size: 13px; color: rgba(255,255,255,0.7); margin-top: 4px; }

/* ── ENDORSEMENT ── */
#agc-{{ uid }} .agc-endorsement {
  background: var(--pale);
  padding: 80px 0;
}
#agc-{{ uid }} .agc-aval-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
#agc-{{ uid }} .agc-aval-eyebrow {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--accent);
  margin-bottom: 14px;
}
#agc-{{ uid }} .agc-aval-title {
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--dark);
  margin-bottom: 20px;
}
#agc-{{ uid }} .agc-aval-quote {
  font-size: 16px;
  line-height: 1.6;
  color: var(--muted);
  margin-bottom: 24px;
  font-style: italic;
}
#agc-{{ uid }} .agc-aval-name { font-size: 16px; font-weight: 700; color: var(--dark); }
#agc-{{ uid }} .agc-aval-role { font-size: 13px; color: var(--muted); margin-bottom: 28px; }
#agc-{{ uid }} .agc-aval-cta {
  display: inline-block;
  padding: 15px 32px;
  background: var(--dark);
  color: white;
  border-radius: 50px;
  font-size: 15px;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.2s;
}
#agc-{{ uid }} .agc-aval-cta:hover { background: var(--accent); }
#agc-{{ uid }} .agc-aval-img-wrap {
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  aspect-ratio: 3/4;
}
#agc-{{ uid }} .agc-aval-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
#agc-{{ uid }} .agc-aval-banner {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: var(--dark);
  color: white;
  padding: 16px 20px;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

/* ── BEFORE/AFTER ── */
#agc-{{ uid }} .agc-before-after {
  background: var(--white);
  padding: 80px 0;
}
#agc-{{ uid }} .agc-ba-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-top: 48px;
}
#agc-{{ uid }} .agc-ba-pair {
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid var(--border);
}
#agc-{{ uid }} .agc-ba-images {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
#agc-{{ uid }} .agc-ba-side { position: relative; }
#agc-{{ uid }} .agc-ba-side img { width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; }
#agc-{{ uid }} .agc-ba-label {
  position: absolute;
  top: 12px; left: 12px;
  background: rgba(26,16,54,0.8);
  color: white;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 4px 10px;
  border-radius: 50px;
}
#agc-{{ uid }} .agc-ba-note {
  text-align: center;
  font-size: 13px;
  color: var(--muted);
  margin-top: 28px;
}

/* ── TESTIMONIALS ── */
#agc-{{ uid }} .agc-testimonials {
  background: var(--pale);
  padding: 80px 0;
}
#agc-{{ uid }} .agc-tc-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 48px;
}
#agc-{{ uid }} .agc-tc-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 28px;
  transition: box-shadow 0.2s;
}
#agc-{{ uid }} .agc-tc-card:hover { box-shadow: 0 8px 30px rgba(26,16,54,0.08); }
#agc-{{ uid }} .agc-tc-avatar {
  width: 48px; height: 48px;
  background: var(--pale);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24px;
  margin-bottom: 14px;
}
#agc-{{ uid }} .agc-tc-name { font-size: 15px; font-weight: 700; color: var(--dark); }
#agc-{{ uid }} .agc-tc-role { font-size: 13px; color: var(--muted); margin-bottom: 10px; }
#agc-{{ uid }} .agc-tc-stars { color: #f5c842; font-size: 14px; letter-spacing: 2px; margin-bottom: 12px; }
#agc-{{ uid }} .agc-tc-quote { font-size: 14px; color: var(--muted); line-height: 1.6; font-style: italic; }

/* ── FAQ ── */
#agc-{{ uid }} .agc-faq {
  background: var(--bg);
  padding: 80px 0;
}
#agc-{{ uid }} .agc-faq-inner { max-width: 720px; margin: 0 auto; }
#agc-{{ uid }} .agc-faq-item {
  border-bottom: 1px solid var(--border);
}
#agc-{{ uid }} .agc-faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 0;
  cursor: pointer;
  font-size: 16px;
  font-weight: 600;
  color: var(--dark);
  gap: 16px;
}
#agc-{{ uid }} .agc-faq-icon {
  flex-shrink: 0;
  width: 24px; height: 24px;
  background: var(--pale);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
  color: var(--accent);
  transition: transform 0.2s;
}
#agc-{{ uid }} .agc-faq-item.open .agc-faq-icon { transform: rotate(45deg); }
#agc-{{ uid }} .agc-faq-a {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.2s ease;
  font-size: 15px;
  color: var(--muted);
  line-height: 1.6;
}
#agc-{{ uid }} .agc-faq-item.open .agc-faq-a { max-height: 400px; padding-bottom: 20px; }

/* ── STICKY ATC ── */
#agc-sticky-{{ uid }} {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: white;
  border-top: 1px solid var(--border, #e3ddd3);
  padding: 12px 24px;
  z-index: 9999;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  box-shadow: 0 -4px 24px rgba(0,0,0,0.1);
}
#agc-sticky-{{ uid }}.visible { transform: translateY(0); }
#agc-sticky-{{ uid }} .agc-sticky-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 20px;
}
#agc-sticky-{{ uid }} .agc-sticky-thumb {
  width: 52px; height: 52px;
  border-radius: 10px;
  overflow: hidden;
  flex-shrink: 0;
}
#agc-sticky-{{ uid }} .agc-sticky-thumb img { width: 100%; height: 100%; object-fit: cover; }
#agc-sticky-{{ uid }} .agc-sticky-name { font-size: 15px; font-weight: 700; color: #1a1036; flex: 1; }
#agc-sticky-{{ uid }} .agc-sticky-price { font-size: 18px; font-weight: 800; color: #1a1036; }
#agc-sticky-{{ uid }} .agc-sticky-btn {
  padding: 12px 28px;
  background: #1a1036;
  color: white;
  border: none;
  border-radius: 50px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s;
  white-space: nowrap;
}
#agc-sticky-{{ uid }} .agc-sticky-btn:hover { background: #2952cc; }

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  #agc-{{ uid }} .agc-hero-grid { grid-template-columns: 1fr; gap: 32px; }
  #agc-{{ uid }} .agc-gallery { position: static; }
  #agc-{{ uid }} .agc-masonry { columns: 2; }
  #agc-{{ uid }} .agc-bens-grid { grid-template-columns: 1fr; }
  #agc-{{ uid }} .agc-prob-grid { grid-template-columns: 1fr; }
  #agc-{{ uid }} .agc-rings-grid { grid-template-columns: 1fr; gap: 32px; }
  #agc-{{ uid }} .agc-aval-grid { grid-template-columns: 1fr; }
  #agc-{{ uid }} .agc-ba-grid { grid-template-columns: 1fr; }
  #agc-{{ uid }} .agc-tc-grid { grid-template-columns: 1fr; }
  #agc-sticky-{{ uid }} .agc-sticky-name { display: none; }
}
</style>

<div id="agc-{{ uid }}">

{%- comment -%} 1. ANNOUNCEMENT BAR {%- endcomment -%}
<div class="agc-announce">
  <div class="agc-marquee-track">
    {%- assign ann_blocks = section.blocks | where: 'type', 'announcement_item' -%}
    {%- for block in ann_blocks -%}
      <span class="agc-marquee-item">{{ block.settings.text }}</span>
    {%- endfor -%}
    {%- for block in ann_blocks -%}
      <span class="agc-marquee-item">{{ block.settings.text }}</span>
    {%- endfor -%}
    {%- if ann_blocks.size == 0 -%}
      <span class="agc-marquee-item">Envío Gratis en Pedidos +$50</span>
      <span class="agc-marquee-item">Filtración Avanzada 9-Etapas</span>
      <span class="agc-marquee-item">Garantía 90 Días</span>
      <span class="agc-marquee-item">+15,000 Clientes Satisfechos</span>
      <span class="agc-marquee-item">Envío Gratis en Pedidos +$50</span>
      <span class="agc-marquee-item">Filtración Avanzada 9-Etapas</span>
      <span class="agc-marquee-item">Garantía 90 Días</span>
      <span class="agc-marquee-item">+15,000 Clientes Satisfechos</span>
    {%- endif -%}
  </div>
</div>

{%- comment -%} 2. HERO / BUY BOX {%- endcomment -%}
<section class="agc-hero">
  <div class="agc-container">
    <div class="agc-hero-grid">

      {%- comment -%} LEFT: Gallery {%- endcomment -%}
      <div class="agc-gallery agc-fade">
        <div class="agc-gallery-main" id="agc-main-img-{{ uid }}">
          {%- if section.settings.gallery_badge != blank -%}
            <span class="agc-gallery-badge">{{ section.settings.gallery_badge }}</span>
          {%- endif -%}
          {%- if product.featured_image -%}
            <img id="agc-hero-img-{{ uid }}" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" width="800" height="800">
          {%- else -%}
            <img id="agc-hero-img-{{ uid }}" src="{{ 'product-1' | placeholder_svg_tag }}" alt="Product">
          {%- endif -%}
        </div>
        <div class="agc-thumbs" id="agc-thumbs-{{ uid }}">
          {%- for image in product.images limit: 6 -%}
            <div class="agc-thumb{% if forloop.first %} active{% endif %}" onclick="agcSetImg_{{ uid }}('{{ image | image_url: width: 800 }}', this)">
              <img src="{{ image | image_url: width: 150 }}" alt="{{ image.alt | escape }}" width="150" height="150" loading="lazy">
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} RIGHT: Buy Box {%- endcomment -%}
      <div class="agc-buybox agc-fade" style="transition-delay:0.1s">
        {%- if section.settings.product_tag != blank -%}
          <div class="agc-tag-pill">{{ section.settings.product_tag }}</div>
        {%- endif -%}

        <h1 class="agc-product-title">
          {%- assign title_parts = section.settings.title | split: '|' -%}
          {%- if title_parts.size > 1 -%}
            {{ title_parts[0] }}<em>{{ title_parts[1] }}</em>{% if title_parts.size > 2 %}{{ title_parts[2] }}{% endif %}
          {%- else -%}
            {{ section.settings.title | default: product.title }}
          {%- endif -%}
        </h1>

        {%- if section.settings.show_rating -%}
          <div class="agc-rating">
            <div class="agc-stars">
              {%- assign rating_stars = section.settings.rating_stars | default: 5 -%}
              {%- for i in (1..rating_stars) -%}★{%- endfor -%}
            </div>
            <span class="agc-rating-val">{{ section.settings.rating_value | default: '4.9' }}</span>
            <span class="agc-rating-cnt">({{ section.settings.rating_count | default: '2,847' }} reseñas)</span>
          </div>
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="agc-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- comment -%} Pricing tiers {%- endcomment -%}
        {%- assign tier_blocks = section.blocks | where: 'type', 'pricing_tier' -%}
        {%- if tier_blocks.size > 0 -%}
          <div class="agc-tier-label">{{ section.settings.tier_label | default: 'Elige tu pack' }}</div>
          <div class="agc-tiers" id="agc-tiers-{{ uid }}">
            {%- for block in tier_blocks -%}
              {%- assign variant = product.variants[forloop.index0] -%}
              <div class="agc-tier-card{% if forloop.first %} selected{% endif %}"
                   onclick="agcSelectTier_{{ uid }}(this, '{{ variant.id }}')"
                   data-variant-id="{{ variant.id }}"
                   data-price="{{ variant.price | money_without_trailing_zeros }}"
                   {{ block.shopify_attributes }}>
                {%- if block.settings.badge != blank -%}
                  <span class="agc-tier-badge">{{ block.settings.badge }}</span>
                {%- endif -%}
                <div class="agc-tier-radio"></div>
                <div class="agc-tier-info">
                  <div class="agc-tier-name">{{ block.settings.name }}</div>
                  {%- if block.settings.unit_note != blank -%}
                    <div class="agc-tier-unit">{{ block.settings.unit_note }}</div>
                  {%- endif -%}
                  {%- if block.settings.sub != blank -%}
                    <div class="agc-tier-sub">{{ block.settings.sub }}</div>
                  {%- endif -%}
                </div>
                <div class="agc-tier-price">
                  <div class="agc-tier-amount">{{ variant.price | money_without_trailing_zeros }}</div>
                  {%- if block.settings.savings != blank -%}
                    <div class="agc-tier-savings">{{ block.settings.savings }}</div>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Quantity + ATC form {%- endcomment -%}
        <form id="agc-form-{{ uid }}" method="post" action="{{ routes.cart_add_url }}">
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" id="agc-variant-{{ uid }}" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" id="agc-qty-hidden-{{ uid }}" name="quantity" value="1">

          <div class="agc-qty-row">
            <span class="agc-qty-label">Cantidad</span>
            <div class="agc-qty-ctrl">
              <button type="button" class="agc-qty-btn" onclick="agcQty_{{ uid }}(-1)">−</button>
              <span class="agc-qty-val" id="agc-qty-disp-{{ uid }}">1</span>
              <button type="button" class="agc-qty-btn" onclick="agcQty_{{ uid }}(1)">+</button>
            </div>
          </div>

          <button type="submit" class="agc-atc-btn" id="agc-atc-{{ uid }}">
            {{ section.settings.cta_text | default: 'Agregar al Carrito' }}
          </button>
        </form>

        {%- if section.settings.delivery_text != blank -%}
          <p class="agc-delivery">{{ section.settings.delivery_text }}</p>
        {%- endif -%}

        {%- comment -%} Urgency bar {%- endcomment -%}
        {%- if section.settings.show_urgency -%}
          <div class="agc-urgency">
            <div class="agc-urgency-head">
              <span>{{ section.settings.urgency_title | default: '¡Quedan pocos en stock!' }}</span>
              <span>{{ section.settings.urgency_percent | default: 72 }}% vendido</span>
            </div>
            <div class="agc-urgency-bar-outer">
              <div class="agc-urgency-bar-inner" style="width: {{ section.settings.urgency_percent | default: 72 }}%"></div>
            </div>
            {%- if section.settings.urgency_note != blank -%}
              <div class="agc-urgency-note">{{ section.settings.urgency_note }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Trust badges {%- endcomment -%}
        {%- assign badge_blocks = section.blocks | where: 'type', 'trust_badge' -%}
        {%- if badge_blocks.size > 0 -%}
          <div class="agc-badges">
            {%- for block in badge_blocks -%}
              <div class="agc-badge" {{ block.shopify_attributes }}>
                <span class="agc-badge-icon">{{ block.settings.icon }}</span>
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Timeline {%- endcomment -%}
        {%- assign tl_blocks = section.blocks | where: 'type', 'timeline_item' -%}
        {%- if tl_blocks.size > 0 -%}
          {%- if section.settings.timeline_label != blank -%}
            <div class="agc-timeline-label">{{ section.settings.timeline_label }}</div>
          {%- endif -%}
          <div class="agc-timeline">
            {%- for block in tl_blocks -%}
              <div class="agc-tl-item" {{ block.shopify_attributes }}>
                <div class="agc-tl-week">{{ block.settings.week }}</div>
                <div class="agc-tl-desc">{{ block.settings.description }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Payment logos {%- endcomment -%}
        {%- assign pay_blocks = section.blocks | where: 'type', 'payment_method' -%}
        {%- if pay_blocks.size > 0 or section.settings.pay_label != blank -%}
          <div class="agc-pay-label">{{ section.settings.pay_label | default: 'Pago seguro con' }}</div>
          <div class="agc-pay-logos">
            {%- if pay_blocks.size > 0 -%}
              {%- for block in pay_blocks -%}
                {%- if block.settings.logo != blank -%}
                  <img class="agc-pay-logo" src="{{ block.settings.logo | image_url: height: 56 }}" alt="{{ block.settings.name | escape }}" height="28" loading="lazy" {{ block.shopify_attributes }}>
                {%- else -%}
                  <span class="agc-pay-pill" {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <span class="agc-pay-pill">Visa</span>
              <span class="agc-pay-pill">Mastercard</span>
              <span class="agc-pay-pill">PayPal</span>
              <span class="agc-pay-pill">Shop Pay</span>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>{%- comment -%} end buybox {%- endcomment -%}
    </div>{%- comment -%} end hero-grid {%- endcomment -%}
  </div>
</section>

{%- comment -%} 3. UGC MASONRY {%- endcomment -%}
<section class="agc-ugc agc-fade">
  <div class="agc-container">
    {%- if section.settings.ugc_eyebrow != blank -%}
      <div class="agc-section-eyebrow">{{ section.settings.ugc_eyebrow }}</div>
    {%- endif -%}
    <h2 class="agc-section-title">{{ section.settings.ugc_title | default: 'Vidas Reales Transformadas' }}</h2>
    {%- assign ugc_blocks = section.blocks | where: 'type', 'ugc_photo' -%}
    {%- if ugc_blocks.size > 0 -%}
      <div class="agc-masonry" id="agc-masonry-{{ uid }}">
        {%- for block in ugc_blocks -%}
          <div class="agc-ugc-card{% if forloop.index > 8 %} agc-ugc-hidden{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.photo != blank -%}
              <img src="{{ block.settings.photo | image_url: width: 400 }}" alt="{{ block.settings.name | escape }}" width="400" loading="lazy">
            {%- else -%}
              <div style="background:var(--pale);aspect-ratio:3/4;display:flex;align-items:center;justify-content:center;font-size:40px;">📸</div>
            {%- endif -%}
            <div class="agc-ugc-overlay">
              <div class="agc-ugc-stars">★★★★★</div>
              {%- if block.settings.quote != blank -%}
                <p class="agc-ugc-quote">"{{ block.settings.quote }}"</p>
              {%- endif -%}
              <div class="agc-ugc-author">{{ block.settings.name }}{%- if block.settings.location != blank -%} · {{ block.settings.location }}{%- endif -%}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if ugc_blocks.size > 8 -%}
        <button class="agc-show-more" id="agc-ugc-more-{{ uid }}" onclick="agcShowMore_{{ uid }}()">
          {{ section.settings.ugc_more_label | default: 'Ver más historias' }}
        </button>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{%- comment -%} 4. BENEFITS {%- endcomment -%}
<section class="agc-benefits agc-fade">
  <div class="agc-container">
    {%- if section.settings.ben_eyebrow != blank -%}
      <div class="agc-section-eyebrow">{{ section.settings.ben_eyebrow }}</div>
    {%- endif -%}
    <h2 class="agc-section-title">{{ section.settings.ben_title | default: 'Lo Que Experimentarás' }}</h2>
    {%- assign ben_blocks = section.blocks | where: 'type', 'benefit' -%}
    {%- if ben_blocks.size > 0 -%}
      <div class="agc-bens-grid">
        {%- for block in ben_blocks -%}
          <div class="agc-ben-card agc-fade" style="transition-delay:{{ forloop.index0 | times: 0.1 }}s" {{ block.shopify_attributes }}>
            {%- if block.settings.icon_img != blank -%}
              <img class="agc-ben-img" src="{{ block.settings.icon_img | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" width="600" loading="lazy">
            {%- elsif block.settings.emoji != blank -%}
              <div style="background:var(--pale);aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;font-size:64px;">{{ block.settings.emoji }}</div>
            {%- endif -%}
            <div class="agc-ben-body">
              {%- if block.settings.emoji != blank and block.settings.icon_img == blank -%}{%- endif -%}
              <div class="agc-ben-title">{{ block.settings.title }}</div>
              {%- if block.settings.description != blank -%}
                <p class="agc-ben-desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.stat_number != blank -%}
                <div class="agc-ben-stat">{{ block.settings.stat_number }}</div>
                {%- if block.settings.stat_label != blank -%}
                  <div class="agc-ben-stat-label">{{ block.settings.stat_label }}</div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} 5. MEDIA MARQUEE {%- endcomment -%}
<div class="agc-media-marquee">
  <div class="agc-media-track">
    {%- assign mq_blocks = section.blocks | where: 'type', 'marquee_item' -%}
    {%- for block in mq_blocks -%}
      <span class="agc-media-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
    {%- endfor -%}
    {%- for block in mq_blocks -%}
      <span class="agc-media-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
    {%- endfor -%}
    {%- if mq_blocks.size == 0 -%}
      <span class="agc-media-item">CNN</span>
      <span class="agc-media-item">Forbes</span>
      <span class="agc-media-item">Business Insider</span>
      <span class="agc-media-item">Healthline</span>
      <span class="agc-media-item">WebMD</span>
      <span class="agc-media-item">CNN</span>
      <span class="agc-media-item">Forbes</span>
      <span class="agc-media-item">Business Insider</span>
      <span class="agc-media-item">Healthline</span>
      <span class="agc-media-item">WebMD</span>
    {%- endif -%}
  </div>
</div>
{%- comment -%} 6. PROBLEM SECTION {%- endcomment -%}
{%- if section.settings.show_problem -%}
<section class="agc-problem agc-fade">
  <div class="agc-container">
    <div class="agc-prob-grid">
      <div class="agc-prob-img">
        {%- if section.settings.prob_image != blank -%}
          <img src="{{ section.settings.prob_image | image_url: width: 700 }}" alt="{{ section.settings.prob_title | escape }}" width="700" loading="lazy">
        {%- else -%}
          <div style="background:rgba(255,255,255,0.05);width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:80px;">🚿</div>
        {%- endif -%}
      </div>
      <div class="agc-prob-content">
        {%- if section.settings.prob_eyebrow != blank -%}
          <div class="agc-prob-eyebrow">{{ section.settings.prob_eyebrow }}</div>
        {%- endif -%}
        <h2 class="agc-prob-title">{{ section.settings.prob_title | default: 'Tu Agua No Es Segura' }}</h2>
        {%- if section.settings.prob_intro != blank -%}
          <p class="agc-prob-intro">{{ section.settings.prob_intro }}</p>
        {%- endif -%}
        {%- assign ps_blocks = section.blocks | where: 'type', 'problem_stat' -%}
        {%- if ps_blocks.size > 0 -%}
          <div class="agc-prob-stats">
            {%- for block in ps_blocks -%}
              <div class="agc-prob-stat" {{ block.shopify_attributes }}>
                <div class="agc-prob-num agc-countup" data-target="{{ block.settings.number | remove: '%' | remove: 'x' | remove: '+' }}">{{ block.settings.number }}</div>
                <div class="agc-prob-label">{{ block.settings.label }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} 7. FILTRATION / CIRCULAR STATS {%- endcomment -%}
<section class="agc-filtration agc-fade">
  <div class="agc-container">
    {%- if section.settings.filt_eyebrow != blank -%}
      <div class="agc-section-eyebrow">{{ section.settings.filt_eyebrow }}</div>
    {%- endif -%}
    <h2 class="agc-section-title">{{ section.settings.filt_title | default: 'Filtración de Primera Clase' }}</h2>
    {%- assign filt_blocks = section.blocks | where: 'type', 'filtration_stat' -%}
    {%- if filt_blocks.size > 0 -%}
      <div class="agc-rings-grid">
        {%- for block in filt_blocks -%}
          {%- assign pct = block.settings.percent | default: 90 -%}
          <div class="agc-ring-wrap agc-fade" style="transition-delay:{{ forloop.index0 | times: 0.15 }}s" {{ block.shopify_attributes }}>
            <div class="agc-ring">
              <svg viewBox="0 0 120 120" width="160" height="160">
                <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="10"/>
                <circle class="agc-ring-arc" cx="60" cy="60" r="50" fill="none" stroke="#fff" stroke-width="10"
                  stroke-dasharray="314.16" stroke-dashoffset="314.16"
                  stroke-linecap="round" transform="rotate(-90 60 60)"
                  data-pct="{{ pct }}"/>
              </svg>
              <div class="agc-ring-num">{{ pct }}%</div>
            </div>
            <div class="agc-ring-label">{{ block.settings.label }}</div>
            {%- if block.settings.sublabel != blank -%}
              <div class="agc-ring-sublabel">{{ block.settings.sublabel }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="agc-rings-grid">
        {%- assign default_rings = '99,Cloro eliminado,Agua más suave para tu piel|86,Metales pesados filtrados,Plomo · Mercurio · Arsénico|94,Bacterias reducidas,Ambiente de ducha más limpio' | split: '|' -%}
        {%- for ring in default_rings -%}
          {%- assign rp = ring | split: ',' -%}
          {%- assign rpct = rp[0] | plus: 0 -%}
          <div class="agc-ring-wrap agc-fade" style="transition-delay:{{ forloop.index0 | times: 0.15 }}s">
            <div class="agc-ring">
              <svg viewBox="0 0 120 120" width="160" height="160">
                <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="10"/>
                <circle class="agc-ring-arc" cx="60" cy="60" r="50" fill="none" stroke="#fff" stroke-width="10"
                  stroke-dasharray="314.16" stroke-dashoffset="314.16"
                  stroke-linecap="round" transform="rotate(-90 60 60)"
                  data-pct="{{ rpct }}"/>
              </svg>
              <div class="agc-ring-num">{{ rpct }}%</div>
            </div>
            <div class="agc-ring-label">{{ rp[1] }}</div>
            <div class="agc-ring-sublabel">{{ rp[2] }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} 8. ENDORSEMENT {%- endcomment -%}
{%- if section.settings.show_aval -%}
<section class="agc-endorsement agc-fade">
  <div class="agc-container">
    <div class="agc-aval-grid">
      <div class="agc-aval-content">
        {%- if section.settings.av_eyebrow != blank -%}
