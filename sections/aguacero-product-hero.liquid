{%- comment -%} 12. STICKY ATC BAR {%- endcomment -%}
{%- if section.settings.show_sticky -%}
<div id="agc-sticky-{{ uid }}">
  <div class="agc-sticky-inner">
    <div class="agc-sticky-thumb">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 104 }}" alt="{{ product.title | escape }}" width="52" height="52">
      {%- endif -%}
    </div>
    <div class="agc-sticky-name">{{ product.title }}</div>
    <div class="agc-sticky-price" id="agc-sticky-price-{{ uid }}">{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</div>
    <button class="agc-sticky-btn" onclick="agcStickyAtc_{{ uid }}()">
      {{ section.settings.cta_text | default: 'Agregar al Carrito' }}
    </button>
  </div>
</div>
{%- endif -%}
<script>
(function() {
  var uid = '{{ section.id }}';

  /* ── Gallery image switcher ── */
  window['agcSetImg_' + uid] = function(src, thumbEl) {
    var img = document.getElementById('agc-hero-img-' + uid);
    if (img) img.src = src;
    var thumbs = document.querySelectorAll('#agc-thumbs-' + uid + ' .agc-thumb');
    thumbs.forEach(function(t) { t.classList.remove('active'); });
    if (thumbEl) thumbEl.classList.add('active');
  };

  /* ── Quantity stepper ── */
  var qty = 1;
  window['agcQty_' + uid] = function(delta) {
    qty = Math.max(1, qty + delta);
    var disp = document.getElementById('agc-qty-disp-' + uid);
    var hidden = document.getElementById('agc-qty-hidden-' + uid);
    if (disp) disp.textContent = qty;
    if (hidden) hidden.value = qty;
  };

  /* ── Tier selector ── */
  window['agcSelectTier_' + uid] = function(el, variantId) {
    var cards = document.querySelectorAll('#agc-tiers-' + uid + ' .agc-tier-card');
    cards.forEach(function(c) { c.classList.remove('selected'); });
    el.classList.add('selected');
    var varInput = document.getElementById('agc-variant-' + uid);
    if (varInput && variantId && variantId !== 'undefined') {
      varInput.value = variantId;
    }
    var price = el.getAttribute('data-price');
    var stickyPrice = document.getElementById('agc-sticky-price-' + uid);
    if (stickyPrice && price) stickyPrice.textContent = price;
  };

  /* ── ATC form: AJAX with fallback ── */
  document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('agc-form-' + uid);
    if (!form) return;
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = document.getElementById('agc-atc-' + uid);
      var variantId = document.getElementById('agc-variant-' + uid).value;
      var quantity = document.getElementById('agc-qty-hidden-' + uid).value;
      if (!variantId) { form.submit(); return; }
      if (btn) { btn.disabled = true; btn.textContent = 'Agregando...'; }
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: variantId, quantity: parseInt(quantity) || 1 })
      })
      .then(function(r) {
        if (!r.ok) throw new Error('Network error');
        return r.json();
      })
      .then(function() {
        if (btn) { btn.disabled = false; btn.textContent = '✓ Agregado al carrito'; }
        setTimeout(function() {
          if (btn) btn.textContent = '{{ section.settings.cta_text | default: "Agregar al Carrito" }}';
        }, 2500);
        document.dispatchEvent(new CustomEvent('cart:updated'));
        // Try to open cart drawer if theme supports it
        if (window.Shopify && window.Shopify.onCartUpdate) window.Shopify.onCartUpdate();
      })
      .catch(function() {
        if (btn) btn.disabled = false;
        form.submit();
      });
    });
  });

  /* ── Sticky ATC ── */
  window['agcStickyAtc_' + uid] = function() {
    var btn = document.getElementById('agc-atc-' + uid);
    if (btn) btn.click();
  };

  /* ── UGC show more ── */
  window['agcShowMore_' + uid] = function() {
    var hidden = document.querySelectorAll('#agc-' + uid + ' .agc-ugc-hidden');
    hidden.forEach(function(el) { el.classList.remove('agc-ugc-hidden'); });
    var moreBtn = document.getElementById('agc-ugc-more-' + uid);
    if (moreBtn) moreBtn.style.display = 'none';
  };

  /* ── FAQ accordion ── */
  window['agcFaq_' + uid] = function(qEl) {
    var item = qEl.parentElement;
    var isOpen = item.classList.contains('open');
    // Close all
    document.querySelectorAll('#agc-' + uid + ' .agc-faq-item.open').forEach(function(i) {
      i.classList.remove('open');
      i.querySelector('.agc-faq-icon').textContent = '+';
    });
    if (!isOpen) {
      item.classList.add('open');
      item.querySelector('.agc-faq-icon').textContent = '×';
    }
  };

  /* ── IntersectionObserver: fade-in ── */
  document.addEventListener('DOMContentLoaded', function() {
    var fadeEls = document.querySelectorAll('#agc-' + uid + ' .agc-fade');
    if ('IntersectionObserver' in window) {
      var fadeObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            fadeObs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      fadeEls.forEach(function(el) { fadeObs.observe(el); });
    } else {
      fadeEls.forEach(function(el) { el.classList.add('is-visible'); });
    }

    /* ── Ring arc animation ── */
    var rings = document.querySelectorAll('#agc-' + uid + ' .agc-ring-arc');
    if ('IntersectionObserver' in window) {
      var ringObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          var arc = entry.target;
          var pct = parseFloat(arc.getAttribute('data-pct')) || 0;
          var circumference = 314.16;
          var target = circumference * (1 - pct / 100);
          var start = circumference;
          var startTime = null;
          var duration = 1200;
          function animateRing(ts) {
            if (!startTime) startTime = ts;
            var progress = Math.min((ts - startTime) / duration, 1);
            var ease = 1 - Math.pow(1 - progress, 3);
            arc.style.strokeDashoffset = (start - (start - target) * ease).toString();
            if (progress < 1) requestAnimationFrame(animateRing);
          }
          requestAnimationFrame(animateRing);
          ringObs.unobserve(arc);
        });
      }, { threshold: 0.3 });
      rings.forEach(function(r) { ringObs.observe(r); });
    }

    /* ── Sticky bar visibility ── */
    var atcBtn = document.getElementById('agc-atc-' + uid);
    var stickyBar = document.getElementById('agc-sticky-' + uid);
    if (atcBtn && stickyBar && 'IntersectionObserver' in window) {
      var stickyObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            stickyBar.classList.remove('visible');
          } else {
            stickyBar.classList.add('visible');
          }
        });
      }, { threshold: 0.1 });
      stickyObs.observe(atcBtn);
    }

    /* ── Count-up animation ── */
    var countEls = document.querySelectorAll('#agc-' + uid + ' .agc-countup');
    if ('IntersectionObserver' in window) {
      var countObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          var el = entry.target;
          var rawTarget = el.getAttribute('data-target');
          var numTarget = parseFloat(rawTarget);
          if (isNaN(numTarget)) return;
          var originalText = el.textContent;
          var prefix = originalText.replace(/[\d.]+.*$/, '');
          var suffix = originalText.replace(/^[^0-9]*[\d.]+/, '');
          var startVal = 0;
          var startTime = null;
          var duration = 1500;
          function animateCount(ts) {
            if (!startTime) startTime = ts;
            var progress = Math.min((ts - startTime) / duration, 1);
            var ease = 1 - Math.pow(1 - progress, 3);
            var current = startVal + (numTarget - startVal) * ease;
            el.textContent = prefix + (Number.isInteger(numTarget) ? Math.round(current) : current.toFixed(1)) + suffix;
            if (progress < 1) requestAnimationFrame(animateCount);
          }
          requestAnimationFrame(animateCount);
          countObs.unobserve(el);
        });
      }, { threshold: 0.5 });
      countEls.forEach(function(el) { countObs.observe(el); });
    }
  });

})();
</script>
