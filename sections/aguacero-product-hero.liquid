    { "type": "color", "id": "color_pale", "label": "Pálido", "default": "#eff4f1" },
    { "type": "color", "id": "color_pale_border", "label": "Borde pálido", "default": "#c6d9ce" },
    { "type": "color", "id": "color_dark", "label": "Oscuro", "default": "#1c1c1c" },
    { "type": "color", "id": "color_text", "label": "Texto", "default": "#1c1c1c" },
    { "type": "color", "id": "color_muted", "label": "Texto tenue", "default": "#6b7c73" },
    { "type": "color", "id": "color_border", "label": "Borde", "default": "#d8e6df" },
    { "type": "color", "id": "color_bg", "label": "Fondo", "default": "#ffffff" },
    { "type": "color", "id": "color_offwhite", "label": "Fondo alterno", "default": "#f8faf9" },
    { "type": "color", "id": "color_ok", "label": "Verde OK", "default": "#4a8060" },

    { "type": "header", "content": "Barra de anuncios" },
