    { "type": "text", "id": "product_tag", "label": "Pill superior", "default": "✦ Tu piel te lo agradecerá" },
    { "type": "text", "id": "title", "label": "Título (usa | para cursiva/acento)", "default": "El secreto de tu piel está en el | agua" },
    { "type": "checkbox", "id": "show_rating", "label": "Mostrar calificación", "default": true },
    { "type": "text", "id": "rating_stars", "label": "Estrellas", "default": "★★★★★" },
    { "type": "text", "id": "rating_value", "label": "Valor", "default": "4.9" },
