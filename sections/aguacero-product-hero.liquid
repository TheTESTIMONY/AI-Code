{%- comment -%}
  ============================================================
  AGUACERO — Showerhead product section (Cold Life style layout)
  Self-contained: no theme JS/CSS dependencies. Scoped styles.
  Add to a product template via the theme customizer.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id | replace: '-', '' | replace: '_', ''
  assign product = product | default: section.settings.product
-%}

<style>
  #agc-{{ uid }}{
    --accent: {{ s.color_accent }};
    --pale: {{ s.color_pale }};
    --pale-border: {{ s.color_pale_border }};
    --dark: {{ s.color_dark }};
    --text: {{ s.color_text }};
    --muted: {{ s.color_muted }};
    --border: {{ s.color_border }};
    --bg: {{ s.color_bg }};
    --offwhite: {{ s.color_offwhite }};
    --ok: {{ s.color_ok }};
    --radius: 14px;
  }
  #agc-{{ uid }} *{ box-sizing:border-box; }
  #agc-{{ uid }}{
    color:var(--text); background:var(--bg);
    font-family:inherit; line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  #agc-{{ uid }} img{ max-width:100%; display:block; }
  #agc-{{ uid }} .agc-wrap{ max-width:1180px; margin:0 auto; padding:0 20px; }
  #agc-{{ uid }} h1,#agc-{{ uid }} h2,#agc-{{ uid }} h3{ margin:0; line-height:1.15; }
  #agc-{{ uid }} .em{ color:var(--accent); font-style:italic; }
  #agc-{{ uid }} .eyebrow{
    text-transform:uppercase; letter-spacing:.16em; font-size:11px;
    font-weight:700; color:var(--accent); margin:0 0 12px;
  }

  /* ---------- announcement bar ---------- */
  #agc-{{ uid }} .agc-ann{
    background:var(--accent); color:#fff; overflow:hidden;
    font-size:12px; font-weight:600; padding:9px 0;
  }
  #agc-{{ uid }} .agc-ann-track{
    display:flex; gap:48px; white-space:nowrap; width:max-content;
    animation:agc-marq-{{ uid }} 26s linear infinite;
  }
  @keyframes agc-marq-{{ uid }}{ from{transform:translateX(0)} to{transform:translateX(-50%)} }

  /* ---------- hero / buy box ---------- */
  #agc-{{ uid }} .agc-hero{ padding:36px 0 8px; }
  #agc-{{ uid }} .agc-hero-grid{
    display:grid; grid-template-columns:1.1fr .9fr; gap:48px; align-items:start;
  }
  #agc-{{ uid }} .agc-gallery .agc-main{
    background:var(--pale); border-radius:var(--radius); overflow:hidden;
    aspect-ratio:1/1; display:flex; align-items:center; justify-content:center;
    position:relative;
  }
  #agc-{{ uid }} .agc-main img{ width:100%; height:100%; object-fit:cover; }
  #agc-{{ uid }} .agc-gbadge{
    position:absolute; top:14px; left:14px; background:var(--dark); color:#fff;
    font-size:11px; font-weight:700; padding:7px 13px; border-radius:40px; z-index:2;
  }
  #agc-{{ uid }} .agc-thumbs{
    display:flex; gap:8px; margin-top:10px; overflow-x:auto; padding-bottom:4px;
  }
  #agc-{{ uid }} .agc-thumb{
    flex:0 0 auto; width:70px; height:70px; border-radius:10px; overflow:hidden;
    border:2px solid var(--border); cursor:pointer; background:var(--pale); padding:0;
  }
  #agc-{{ uid }} .agc-thumb.is-active{ border-color:var(--accent); }
  #agc-{{ uid }} .agc-thumb img{ width:100%; height:100%; object-fit:cover; }

  #agc-{{ uid }} .agc-tag{
    display:inline-block; background:var(--pale); color:var(--ok);
    border:1px solid var(--pale-border); border-radius:50px;
    font-size:12px; font-weight:600; padding:5px 14px; margin-bottom:14px;
  }
  #agc-{{ uid }} .agc-title{ font-size:30px; font-weight:800; letter-spacing:-.01em; }
  #agc-{{ uid }} .agc-rating{
    display:flex; align-items:center; gap:8px; margin:12px 0;
    font-size:13px; color:var(--muted);
  }
  #agc-{{ uid }} .agc-stars{ color:var(--accent); letter-spacing:2px; }
  #agc-{{ uid }} .agc-tagline{ color:var(--muted); font-size:15px; margin:0 0 22px; }

  #agc-{{ uid }} .agc-flabel{
    font-size:12px; font-weight:700; text-transform:uppercase;
    letter-spacing:.08em; color:var(--text); margin:18px 0 10px;
  }

  /* variant pills */
  #agc-{{ uid }} .agc-variants{ display:flex; flex-wrap:wrap; gap:8px; }
  #agc-{{ uid }} .agc-variant{ position:relative; }
  #agc-{{ uid }} .agc-variant input{ position:absolute; opacity:0; pointer-events:none; }
  #agc-{{ uid }} .agc-variant label{
    display:block; cursor:pointer; padding:10px 16px; border-radius:10px;
    border:1.5px solid var(--border); background:#fff; font-size:14px; font-weight:600;
    transition:.15s;
  }
  #agc-{{ uid }} .agc-variant input:checked + label{
    border-color:var(--accent); background:var(--pale);
  }
  #agc-{{ uid }} .agc-variant input:disabled + label{
    opacity:.4; text-decoration:line-through; cursor:not-allowed;
  }

  /* pricing tiers */
  #agc-{{ uid }} .agc-tiers{ display:flex; flex-direction:column; gap:10px; }
  #agc-{{ uid }} .agc-tier input[type=radio]{ position:absolute; opacity:0; pointer-events:none; }
  #agc-{{ uid }} .agc-tier:has(input:checked){ border-color:var(--accent); background:var(--pale); }
  #agc-{{ uid }} .agc-tier:has(input:checked) .agc-tier-radio{ border-color:var(--accent); }
  #agc-{{ uid }} .agc-tier:has(input:checked) .agc-tier-radio::after{ content:""; position:absolute; inset:4px; border-radius:50%; background:var(--accent); }
  #agc-{{ uid }} .agc-tier:has(input:disabled){ opacity:.45; }
  #agc-{{ uid }} .agc-tier{
    position:relative; border:1.5px solid var(--border); border-radius:12px;
    background:#fff; padding:14px 16px; cursor:pointer; transition:.15s;
    display:flex; align-items:center; gap:14px;
  }
  #agc-{{ uid }} .agc-tier.is-active{ border-color:var(--accent); background:var(--pale); }
  #agc-{{ uid }} .agc-tier-radio{
    width:20px; height:20px; border-radius:50%; border:2px solid var(--border);
    flex:0 0 auto; position:relative;
  }
  #agc-{{ uid }} .agc-tier.is-active .agc-tier-radio{ border-color:var(--accent); }
  #agc-{{ uid }} .agc-tier.is-active .agc-tier-radio::after{
    content:""; position:absolute; inset:4px; border-radius:50%; background:var(--accent);
  }
  #agc-{{ uid }} .agc-tier-body{ flex:1; }
  #agc-{{ uid }} .agc-tier-name{ font-weight:700; font-size:15px; }
  #agc-{{ uid }} .agc-tier-sub{ font-size:12px; color:var(--muted); margin-top:2px; }
  #agc-{{ uid }} .agc-tier-price{ text-align:right; }
  #agc-{{ uid }} .agc-tier-each{ font-weight:800; font-size:16px; }
  #agc-{{ uid }} .agc-tier-unit{ font-size:11px; color:var(--muted); }
  #agc-{{ uid }} .agc-tier-badge{
    position:absolute; top:-9px; right:14px; background:var(--dark); color:#fff;
    font-size:10px; font-weight:700; padding:3px 9px; border-radius:40px;
  }
  #agc-{{ uid }} .agc-save{
    font-size:11px; font-weight:700; color:var(--ok); background:var(--pale);
    border-radius:6px; padding:2px 7px; margin-left:8px;
  }

  /* cta */
  #agc-{{ uid }} .agc-qty{ display:flex; align-items:center; gap:0; margin:16px 0 0;
    border:1.5px solid var(--border); border-radius:10px; width:fit-content; overflow:hidden; }
  #agc-{{ uid }} .agc-qty button{
    background:#fff; border:0; width:42px; height:44px; font-size:18px; cursor:pointer; color:var(--text);
  }
  #agc-{{ uid }} .agc-qty input{ width:44px; height:44px; border:0; text-align:center; font-size:15px; font-weight:600;
    -moz-appearance:textfield; }
  #agc-{{ uid }} .agc-qty input::-webkit-outer-spin-button,
  #agc-{{ uid }} .agc-qty input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }

  #agc-{{ uid }} .agc-cta{
    width:100%; margin-top:16px; border:0; cursor:pointer;
    background:var(--dark); color:#fff; font-weight:700; font-size:15px;
    padding:17px; border-radius:50px; transition:.18s; letter-spacing:.01em;
  }
  #agc-{{ uid }} .agc-cta:hover{ background:var(--accent); }
  #agc-{{ uid }} .agc-cta:disabled{ opacity:.5; cursor:not-allowed; }

  #agc-{{ uid }} .agc-delivery{ font-size:13px; color:var(--muted); margin-top:14px; }
  #agc-{{ uid }} .agc-delivery strong{ color:var(--ok); }

  /* urgency */
  #agc-{{ uid }} .agc-urgency{
    margin-top:18px; background:var(--offwhite); border:1px solid var(--border);
    border-radius:12px; padding:16px;
  }
  #agc-{{ uid }} .agc-urgency-top{ display:flex; justify-content:space-between; font-size:12px;
    font-weight:700; margin-bottom:8px; }
  #agc-{{ uid }} .agc-urgency-bar{ height:8px; background:var(--border); border-radius:50px; overflow:hidden; }
  #agc-{{ uid }} .agc-urgency-fill{ height:100%; background:var(--accent); border-radius:50px; }
  #agc-{{ uid }} .agc-urgency-note{ font-size:12px; color:var(--muted); margin-top:8px; }

  /* trust badges row */
  #agc-{{ uid }} .agc-trust{ display:flex; flex-wrap:wrap; gap:14px; margin-top:18px; }
  #agc-{{ uid }} .agc-trust-item{ display:flex; align-items:center; gap:6px;
    font-size:12px; color:var(--muted); font-weight:600; }
  #agc-{{ uid }} .agc-trust-item .ic{ font-size:16px; }

  /* timeline */
  #agc-{{ uid }} .agc-timeline{ margin-top:20px; border-top:1px solid var(--border); padding-top:18px; }
  #agc-{{ uid }} .agc-tl-row{ display:flex; gap:12px; align-items:flex-start; margin-bottom:10px; font-size:13px; }
  #agc-{{ uid }} .agc-tl-dot{ width:9px; height:9px; border-radius:50%; background:var(--accent);
    margin-top:5px; flex:0 0 auto; }
  #agc-{{ uid }} .agc-tl-row b{ color:var(--text); }
  #agc-{{ uid }} .agc-tl-row span{ color:var(--muted); }

  /* payments */
  #agc-{{ uid }} .agc-pay{ display:flex; align-items:center; gap:14px; flex-wrap:wrap;
    margin-top:18px; font-size:12px; color:var(--muted); }
  #agc-{{ uid }} .agc-pay img{ height:26px; width:auto; border-radius:4px; }

  /* ---------- generic section ---------- */
  #agc-{{ uid }} .agc-sec{ padding:70px 0; }
  #agc-{{ uid }} .agc-sec.alt{ background:var(--offwhite); }
  #agc-{{ uid }} .agc-sec.dark{ background:var(--dark); color:#fff; }
  #agc-{{ uid }} .agc-sec.accent{ background:var(--accent); color:#fff; }
  #agc-{{ uid }} .agc-sec-head{ text-align:center; max-width:640px; margin:0 auto 44px; }
  #agc-{{ uid }} .agc-sec-title{ font-size:34px; font-weight:800; letter-spacing:-.01em; }
  #agc-{{ uid }} .agc-sec.dark .agc-sec-title,
  #agc-{{ uid }} .agc-sec.accent .agc-sec-title{ color:#fff; }
  #agc-{{ uid }} .agc-sec-sub{ color:var(--muted); font-size:16px; margin-top:12px; }
  #agc-{{ uid }} .agc-sec.accent .agc-sec-sub{ color:rgba(255,255,255,.85); }

  /* benefits ("you'll experience") */
  #agc-{{ uid }} .agc-benefits{ display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  #agc-{{ uid }} .agc-benefit{ background:var(--pale); border:1px solid var(--border);
    border-radius:14px; padding:28px 22px; text-align:center; }
  #agc-{{ uid }} .agc-benefit .ic{ font-size:42px; }
  #agc-{{ uid }} .agc-benefit img{ height:64px; width:auto; margin:0 auto; }
  #agc-{{ uid }} .agc-benefit h3{ font-size:18px; font-weight:700; margin:14px 0 8px; }
  #agc-{{ uid }} .agc-benefit p{ color:var(--muted); font-size:14px; margin:0; }

  /* stats */
  #agc-{{ uid }} .agc-stats{ display:grid; grid-template-columns:repeat(3,1fr); gap:32px; text-align:center; }
  #agc-{{ uid }} .agc-stat-num{ font-size:60px; font-weight:800; line-height:1; color:#fff; }
  #agc-{{ uid }} .agc-stat-label{ color:rgba(255,255,255,.9); font-size:14px; margin-top:12px; }

  /* comparison */
  #agc-{{ uid }} .agc-cmp{ max-width:760px; margin:0 auto; border-radius:16px; overflow:hidden;
    border:1px solid var(--border); }
  #agc-{{ uid }} .agc-cmp-head{ display:grid; grid-template-columns:1fr 130px 130px; }
  #agc-{{ uid }} .agc-cmp-head > div{ padding:16px; font-weight:700; font-size:13px; text-align:center; color:#fff; }
  #agc-{{ uid }} .agc-cmp-head .f{ background:var(--pale); color:var(--text); text-align:left; }
  #agc-{{ uid }} .agc-cmp-head .us{ background:var(--accent); }
  #agc-{{ uid }} .agc-cmp-head .them{ background:var(--dark); }
  #agc-{{ uid }} .agc-cmp-row{ display:grid; grid-template-columns:1fr 130px 130px; border-top:1px solid var(--border); }
  #agc-{{ uid }} .agc-cmp-row > div{ padding:16px; display:flex; align-items:center; justify-content:center; }
  #agc-{{ uid }} .agc-cmp-row .f{ justify-content:flex-start; flex-direction:column; align-items:flex-start; background:#fff; }
  #agc-{{ uid }} .agc-cmp-row .f b{ font-size:13px; font-weight:700; letter-spacing:.02em; }
  #agc-{{ uid }} .agc-cmp-row .f span{ font-size:12px; color:var(--muted); }
  #agc-{{ uid }} .agc-cmp-row .us{ background:var(--pale); }
  #agc-{{ uid }} .agc-cmp-row .them{ background:var(--offwhite); }
  #agc-{{ uid }} .agc-yes{ color:var(--accent); font-size:20px; font-weight:700; }
  #agc-{{ uid }} .agc-no{ color:var(--border); font-size:20px; }

  /* filter layers (tabs) */
  #agc-{{ uid }} .agc-tabs{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-bottom:28px; }
  #agc-{{ uid }} .agc-tab{
    border:1px solid var(--border); background:#fff; color:var(--muted);
    border-radius:50px; padding:9px 18px; font-size:13px; font-weight:600; cursor:pointer; transition:.15s;
  }
  #agc-{{ uid }} .agc-tab.is-active{ background:var(--dark); color:#fff; border-color:var(--dark); }
  #agc-{{ uid }} .agc-layer{ display:none; max-width:680px; margin:0 auto; text-align:center; }
  #agc-{{ uid }} .agc-layer.is-active{ display:block; }
  #agc-{{ uid }} .agc-layer-badge{ display:inline-block; background:var(--pale); color:var(--ok);
    border-radius:50px; padding:5px 14px; font-size:12px; font-weight:700; margin-bottom:14px; }
  #agc-{{ uid }} .agc-layer h3{ font-size:24px; font-weight:800; margin-bottom:8px; }
  #agc-{{ uid }} .agc-layer .hint{ font-size:13px; color:var(--muted); margin-bottom:14px; }
  #agc-{{ uid }} .agc-layer p{ color:var(--text); font-size:16px; line-height:1.6; }

  /* testimonials */
  #agc-{{ uid }} .agc-tcards{ display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  #agc-{{ uid }} .agc-tcard{ background:#fff; border:1px solid var(--border); border-radius:14px; padding:24px; }
  #agc-{{ uid }} .agc-tcard-top{ display:flex; align-items:center; gap:12px; margin-bottom:14px; }
  #agc-{{ uid }} .agc-tcard-av{ width:46px; height:46px; border-radius:50%; background:var(--pale);
    border:2px solid var(--pale-border); display:flex; align-items:center; justify-content:center; font-size:22px; }
  #agc-{{ uid }} .agc-tcard-name{ font-weight:700; font-size:14px; }
  #agc-{{ uid }} .agc-tcard-role{ font-size:12px; color:var(--muted); }
  #agc-{{ uid }} .agc-tcard .agc-stars{ font-size:13px; margin-bottom:8px; display:block; }
  #agc-{{ uid }} .agc-tcard p{ font-size:14px; color:var(--text); margin:0; line-height:1.55; }

  /* faq */
  #agc-{{ uid }} .agc-faq{ max-width:720px; margin:0 auto; }
  #agc-{{ uid }} .agc-faq-item{ background:#fff; border:1px solid var(--border); border-radius:12px;
    margin-bottom:10px; overflow:hidden; }
  #agc-{{ uid }} .agc-faq-q{ width:100%; text-align:left; background:none; border:0; cursor:pointer;
    padding:18px 20px; font-size:15px; font-weight:700; color:var(--text);
    display:flex; justify-content:space-between; align-items:center; gap:12px; }
  #agc-{{ uid }} .agc-faq-q .pm{ font-size:20px; color:var(--accent); transition:.2s; flex:0 0 auto; }
  #agc-{{ uid }} .agc-faq-item.is-open .pm{ transform:rotate(45deg); }
  #agc-{{ uid }} .agc-faq-a{ max-height:0; overflow:hidden; transition:max-height .25s ease; }
  #agc-{{ uid }} .agc-faq-a-inner{ padding:0 20px 18px; color:var(--muted); font-size:14px; line-height:1.6; }

  /* feature cards */
  #agc-{{ uid }} .agc-features{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
  #agc-{{ uid }} .agc-fcard{ background:#fff; border:1px solid var(--border); border-radius:12px; padding:24px; }
  #agc-{{ uid }} .agc-fcard .ic{ font-size:32px; }
  #agc-{{ uid }} .agc-fcard img{ height:44px; width:auto; }
  #agc-{{ uid }} .agc-fcard h3{ font-size:16px; font-weight:700; margin:14px 0 8px; }
  #agc-{{ uid }} .agc-fcard p{ color:var(--muted); font-size:13px; margin:0; }

  /* problem section */
  #agc-{{ uid }} .agc-problem-grid{ display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center; }
  #agc-{{ uid }} .agc-problem-img{ border-radius:var(--radius); overflow:hidden; aspect-ratio:4/3; background:#2a2a2a; }
  #agc-{{ uid }} .agc-problem-img img{ width:100%; height:100%; object-fit:cover; }
  #agc-{{ uid }} .agc-problem-intro{ font-size:16px; color:rgba(255,255,255,.8); margin:0 0 26px; line-height:1.6; }
  #agc-{{ uid }} .agc-pstat{ border-top:1px solid rgba(255,255,255,.15); padding:16px 0; display:flex; gap:18px; align-items:baseline; }
  #agc-{{ uid }} .agc-pstat-num{ font-size:34px; font-weight:800; color:var(--accent); flex:0 0 auto; min-width:84px; }
  #agc-{{ uid }} .agc-pstat-label{ font-size:14px; color:rgba(255,255,255,.85); }

  /* cause cards */
  #agc-{{ uid }} .agc-causes{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
  #agc-{{ uid }} .agc-cause{ border-radius:14px; overflow:hidden; border:1px solid var(--border); background:#fff; }
  #agc-{{ uid }} .agc-cause-img{ aspect-ratio:1/1; background:var(--pale); }
  #agc-{{ uid }} .agc-cause-img img{ width:100%; height:100%; object-fit:cover; }
  #agc-{{ uid }} .agc-cause-body{ padding:18px; }
  #agc-{{ uid }} .agc-cause-body h3{ font-size:16px; font-weight:700; margin:0 0 6px; }
  #agc-{{ uid }} .agc-cause-body p{ font-size:13px; color:var(--muted); margin:0; line-height:1.5; }

  /* endorsement */
  #agc-{{ uid }} .agc-aval{ display:grid; grid-template-columns:300px 1fr; gap:40px; align-items:center;
    background:var(--pale); border:1px solid var(--pale-border); border-radius:20px; padding:36px; }
  #agc-{{ uid }} .agc-aval-img{ width:100%; aspect-ratio:1/1; border-radius:16px; overflow:hidden; background:#fff; }
  #agc-{{ uid }} .agc-aval-img img{ width:100%; height:100%; object-fit:cover; }
  #agc-{{ uid }} .agc-aval h2{ font-size:28px; font-weight:800; margin:0 0 14px; }
  #agc-{{ uid }} .agc-aval-quote{ font-size:17px; line-height:1.6; color:var(--text); margin:0 0 16px; }
  #agc-{{ uid }} .agc-aval-name{ font-weight:700; }
  #agc-{{ uid }} .agc-aval-role{ font-size:13px; color:var(--muted); }

  /* before / after */
  #agc-{{ uid }} .agc-ba-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:24px; }
  #agc-{{ uid }} .agc-ba{ display:grid; grid-template-columns:1fr 1fr; gap:8px; border-radius:14px; overflow:hidden; }
  #agc-{{ uid }} .agc-ba figure{ margin:0; position:relative; }
  #agc-{{ uid }} .agc-ba figure span{ position:absolute; top:10px; left:10px; background:var(--dark); color:#fff;
    font-size:11px; font-weight:700; padding:4px 10px; border-radius:40px; text-transform:uppercase; letter-spacing:.05em; }
  #agc-{{ uid }} .agc-ba figure:last-child span{ background:var(--accent); }
  #agc-{{ uid }} .agc-ba .ph{ aspect-ratio:3/4; background:var(--pale); }
  #agc-{{ uid }} .agc-ba img{ width:100%; aspect-ratio:3/4; object-fit:cover; }
  #agc-{{ uid }} .agc-ba-note{ text-align:center; color:var(--muted); font-size:14px; margin-top:30px; }

  /* video */
  #agc-{{ uid }} .agc-videos{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
  #agc-{{ uid }} .agc-video{ position:relative; aspect-ratio:9/16; border-radius:14px; overflow:hidden; background:var(--dark); }
  #agc-{{ uid }} .agc-video img,#agc-{{ uid }} .agc-video video{ width:100%; height:100%; object-fit:cover; }
  #agc-{{ uid }} .agc-video .play{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; }
  #agc-{{ uid }} .agc-video .play span{ width:54px; height:54px; border-radius:50%; background:rgba(255,255,255,.9);
    display:flex; align-items:center; justify-content:center; font-size:18px; color:var(--dark); }
  #agc-{{ uid }} .agc-video .vlabel{ position:absolute; left:12px; right:12px; bottom:12px; color:#fff; font-size:13px;
    font-weight:600; text-shadow:0 1px 4px rgba(0,0,0,.6); }

  #agc-{{ uid }} .agc-tier-img{ width:48px; height:48px; border-radius:8px; object-fit:cover; flex:0 0 auto; background:var(--pale); }

  /* specs section */
  #agc-{{ uid }} .agc-specs-grid{ display:grid; grid-template-columns:1fr 1fr; gap:48px; max-width:980px; margin:0 auto; }
  #agc-{{ uid }} .agc-specs-block h3{ font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:.1em;
    color:var(--accent); margin:0 0 16px; }
  #agc-{{ uid }} .agc-ovp{ display:flex; gap:12px; padding:12px 0; border-bottom:1px solid var(--border); }
  #agc-{{ uid }} .agc-ovp .ck{ color:var(--accent); font-weight:800; flex:0 0 auto; }
  #agc-{{ uid }} .agc-ovp b{ display:block; font-size:14px; }
  #agc-{{ uid }} .agc-ovp span{ font-size:13px; color:var(--muted); }
  #agc-{{ uid }} .agc-speclist{ list-style:none; margin:0 0 28px; padding:0; }
  #agc-{{ uid }} .agc-speclist li{ font-size:13px; color:var(--text); padding:7px 0 7px 18px; position:relative; border-bottom:1px solid var(--border); }
  #agc-{{ uid }} .agc-speclist li::before{ content:"–"; position:absolute; left:0; color:var(--accent); }
  #agc-{{ uid }} .agc-spec-title{ font-size:15px; font-weight:700; margin:0 0 10px; }

  /* sticky add to cart */
  #agc-{{ uid }}-sticky{ position:fixed; left:0; right:0; bottom:0; z-index:50; transform:translateY(110%);
    transition:transform .25s ease; background:#fff; border-top:1px solid var(--border);
    box-shadow:0 -6px 24px rgba(0,0,0,.08); padding:12px 16px; }
  #agc-{{ uid }}-sticky.show{ transform:translateY(0); }
  #agc-{{ uid }}-sticky .in{ max-width:1180px; margin:0 auto; display:flex; align-items:center; gap:16px; }
  #agc-{{ uid }}-sticky .nm{ font-weight:700; font-size:14px; flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  #agc-{{ uid }}-sticky .pr{ font-weight:800; font-size:15px; }
  #agc-{{ uid }}-sticky button{ border:0; cursor:pointer; background:var(--dark); color:#fff; font-weight:700;
    padding:12px 26px; border-radius:50px; font-size:14px; }
  #agc-{{ uid }}-sticky button:hover{ background:var(--accent); }
  @media (max-width:600px){ #agc-{{ uid }}-sticky .nm{ display:none; } }

  /* responsive */
  @media (max-width:880px){
    #agc-{{ uid }} .agc-hero-grid{ grid-template-columns:1fr; gap:28px; }
    #agc-{{ uid }} .agc-benefits,
    #agc-{{ uid }} .agc-features{ grid-template-columns:1fr; }
    #agc-{{ uid }} .agc-stats{ grid-template-columns:1fr; gap:36px; }
    #agc-{{ uid }} .agc-tcards{ grid-template-columns:1fr; }
    #agc-{{ uid }} .agc-problem-grid,
    #agc-{{ uid }} .agc-causes,
    #agc-{{ uid }} .agc-ba-grid{ grid-template-columns:1fr; }
    #agc-{{ uid }} .agc-videos{ grid-template-columns:1fr 1fr; }
    #agc-{{ uid }} .agc-aval{ grid-template-columns:1fr; padding:24px; }
    #agc-{{ uid }} .agc-specs-grid{ grid-template-columns:1fr; gap:28px; }
    #agc-{{ uid }} .agc-sec{ padding:48px 0; }
    #agc-{{ uid }} .agc-title{ font-size:25px; }
    #agc-{{ uid }} .agc-sec-title{ font-size:26px; }
    #agc-{{ uid }} .agc-stat-num{ font-size:48px; }
    #agc-{{ uid }} .agc-cmp-head,
    #agc-{{ uid }} .agc-cmp-row{ grid-template-columns:1fr 70px 70px; }
    #agc-{{ uid }} .agc-cmp-head > div,
    #agc-{{ uid }} .agc-cmp-row > div{ padding:12px 8px; font-size:11px; }
  }
  
  /* ugc masonry */
  #agc-{{ uid }} .agc-ugc-grid{ columns:4; column-gap:14px; }
  #agc-{{ uid }} .agc-ugc-card{
    break-inside:avoid; margin-bottom:14px; border-radius:14px;
    overflow:hidden; position:relative; background:var(--pale); cursor:pointer;
  }
  #agc-{{ uid }} .agc-ugc-card img{ width:100%; display:block; object-fit:cover; }
  #agc-{{ uid }} .agc-ugc-ph{ width:100%; aspect-ratio:3/4; background:var(--pale); }
  #agc-{{ uid }} .agc-ugc-overlay{
    position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,.75) 50%, transparent 80%);
    display:flex; flex-direction:column; justify-content:flex-end;
    padding:16px; opacity:0; transition:.2s;
  }
  #agc-{{ uid }} .agc-ugc-card:hover .agc-ugc-overlay{ opacity:1; }
  #agc-{{ uid }} .agc-ugc-overlay .agc-stars{ font-size:12px; margin-bottom:6px; }
  #agc-{{ uid }} .agc-ugc-overlay .agc-ugc-quote{ color:#fff; font-size:13px; line-height:1.45; margin:0 0 8px; font-weight:600; }
  #agc-{{ uid }} .agc-ugc-overlay .agc-ugc-author{ color:rgba(255,255,255,.8); font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; }
  #agc-{{ uid }} .agc-ugc-inline{ padding:12px; background:var(--pale); }
  #agc-{{ uid }} .agc-ugc-inline .agc-stars{ font-size:12px; }
  #agc-{{ uid }} .agc-ugc-inline .agc-ugc-quote{ color:var(--text); font-size:13px; margin:6px 0; }
  #agc-{{ uid }} .agc-ugc-inline .agc-ugc-author{ color:var(--muted); font-size:11px; font-weight:700; }
  #agc-{{ uid }} .agc-ugc-more{
    display:block; margin:24px auto 0; border:1.5px solid var(--accent); background:#fff;
    color:var(--accent); font-weight:700; font-size:14px; padding:12px 36px; border-radius:50px; cursor:pointer; transition:.15s;
  }
  #agc-{{ uid }} .agc-ugc-more:hover{ background:var(--accent); color:#fff; }
  #agc-{{ uid }} .agc-ugc-hidden{ display:none; }
  @media(max-width:880px){ #agc-{{ uid }} .agc-ugc-grid{ columns:2; } }
  @media (prefers-reduced-motion:reduce){
    #agc-{{ uid }} .agc-ann-track{ animation:none; }
  }
</style>

<div id="agc-{{ uid }}">

  {%- comment -%} ============ ANNOUNCEMENT BAR ============ {%- endcomment -%}
  {%- if s.show_ann -%}
    {%- assign ann_blocks = section.blocks | where: "type", "announcement_item" -%}
    {%- if ann_blocks.size > 0 -%}
      <div class="agc-ann">
        <div class="agc-ann-track">
          {%- for i in (1..2) -%}
            {%- for b in ann_blocks -%}<span>{{ b.settings.text }}</span>{%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} ============ HERO / BUY BOX ============ {%- endcomment -%}
  <div class="agc-hero">
    <div class="agc-wrap agc-hero-grid">

      {%- comment -%} GALLERY {%- endcomment -%}
      <div class="agc-gallery">
        <div class="agc-main">
          {%- if s.gallery_badge != blank -%}<span class="agc-gbadge">{{ s.gallery_badge }}</span>{%- endif -%}
          {%- if product and product.media.size > 0 -%}
            <img id="agc-main-{{ uid }}" src="{{ product.featured_media | image_url: width: 900 }}" width="{{ product.featured_media.width }}" height="{{ product.featured_media.height }}" loading="eager" alt="{{ product.title | escape }}">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'agc-ph' }}
          {%- endif -%}
        </div>
        {%- if product and product.media.size > 1 -%}
          <div class="agc-thumbs">
            {%- for media in product.media -%}
              <button type="button" class="agc-thumb {% if forloop.first %}is-active{% endif %}"
                      data-full="{{ media | image_url: width: 900 }}"
                      onclick="agcThumb_{{ uid }}(this)">
                <img src="{{ media | image_url: width: 160 }}" width="160" height="160" loading="lazy" alt="">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} INFO {%- endcomment -%}
      <div class="agc-info">
        {%- if s.product_tag != blank -%}<span class="agc-tag">{{ s.product_tag }}</span>{%- endif -%}

        <h1 class="agc-title">{{ s.title | replace: '|', '<span class="em">' | append: '</span>' }}</h1>

        {%- if s.show_rating -%}
          <div class="agc-rating">
            <span class="agc-stars">{{ s.rating_stars }}</span>
            <strong>{{ s.rating_value }}</strong>
            <span>· {{ s.rating_count }}</span>
          </div>
        {%- endif -%}

        {%- if s.tagline != blank -%}<p class="agc-tagline">{{ s.tagline }}</p>{%- endif -%}

        <form id="agc-form-{{ uid }}" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">

          {%- comment -%} PACK SELECTOR — driven by REAL product variants with live prices {%- endcomment -%}
          {%- assign tiers = section.blocks | where: "type", "pricing_tier" -%}
          {%- if product and product.variants.size > 0 -%}
            <div class="agc-flabel">{{ s.tier_label }}</div>
            <div class="agc-tiers" id="agc-tiers-{{ uid }}">
              {%- for v in product.variants -%}
                {%- assign t = tiers[forloop.index0] -%}
                <label class="agc-tier {% if v == product.selected_or_first_available_variant %}is-active{% endif %}">
                  <input type="radio" name="id" value="{{ v.id }}"
                         {% if v == product.selected_or_first_available_variant %}checked{% endif %}
                         {% unless v.available %}disabled{% endunless %}>
                  {%- if t.settings.badge != blank -%}<span class="agc-tier-badge">{{ t.settings.badge }}</span>{%- endif -%}
                  <span class="agc-tier-radio"></span>
                  {%- if s.show_pack_img -%}
                    {%- assign tier_img = v.image | default: product.featured_media -%}
                    {%- if tier_img -%}<img class="agc-tier-img" src="{{ tier_img | image_url: width: 140 }}" width="60" height="60" loading="lazy" alt="">{%- endif -%}
                  {%- endif -%}
                  <div class="agc-tier-body">
                    <div class="agc-tier-name">{{ t.settings.name | default: v.title }}
                      {%- if t.settings.savings != blank -%}<span class="agc-save">{{ t.settings.savings }}</span>{%- endif -%}
                    </div>
                    {%- if t.settings.sub != blank -%}<div class="agc-tier-sub">{{ t.settings.sub }}</div>
                    {%- else -%}<div class="agc-tier-sub">{{ v.title }}</div>{%- endif -%}
                  </div>
                  <div class="agc-tier-price">
                    <div class="agc-tier-each">{{ v.price | money }}</div>
                    {%- if v.compare_at_price > v.price -%}
                      <div class="agc-tier-unit"><s>{{ v.compare_at_price | money }}</s></div>
                    {%- elsif t.settings.unit_note != blank -%}
                      <div class="agc-tier-unit">{{ t.settings.unit_note }}</div>
                    {%- endif -%}
                  </div>
                </label>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- comment -%} QUANTITY {%- endcomment -%}
          <div class="agc-qty">
            <button type="button" onclick="agcQty_{{ uid }}(-1)">−</button>
            <input type="number" name="quantity" id="agc-qty-{{ uid }}" value="1" min="1">
            <button type="button" onclick="agcQty_{{ uid }}(1)">+</button>
          </div>

          {%- comment -%} CTA {%- endcomment -%}
          {%- if product and product.available -%}
            <button type="submit" class="agc-cta" id="agc-cta-{{ uid }}">{{ s.cta_text }}</button>
          {%- else -%}
            <button type="button" class="agc-cta" disabled>{{ s.sold_out_text }}</button>
          {%- endif -%}
        </form>

        {%- if s.delivery_text != blank -%}<p class="agc-delivery">{{ s.delivery_text }}</p>{%- endif -%}

        {%- comment -%} URGENCY {%- endcomment -%}
        {%- if s.show_urgency -%}
          <div class="agc-urgency">
            <div class="agc-urgency-top">
              <span>{{ s.urgency_title }}</span><span>{{ s.urgency_percent }}%</span>
            </div>
            <div class="agc-urgency-bar"><div class="agc-urgency-fill" style="width:{{ s.urgency_percent }}%"></div></div>
            <div class="agc-urgency-note">{{ s.urgency_note }}</div>
          </div>
        {%- endif -%}

        {%- comment -%} TRUST BADGES {%- endcomment -%}
        {%- assign trust = section.blocks | where: "type", "trust_badge" -%}
        {%- if trust.size > 0 -%}
          <div class="agc-trust">
            {%- for b in trust -%}
              <span class="agc-trust-item"><span class="ic">{{ b.settings.icon }}</span>{{ b.settings.label }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} TIMELINE {%- endcomment -%}
        {%- assign tl = section.blocks | where: "type", "timeline_item" -%}
        {%- if tl.size > 0 -%}
          <div class="agc-timeline">
            <div class="agc-flabel">{{ s.timeline_label }}</div>
            {%- for b in tl -%}
              <div class="agc-tl-row"><span class="agc-tl-dot"></span>
                <div><b>{{ b.settings.week }}</b> <span>{{ b.settings.description }}</span></div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} PAYMENTS {%- endcomment -%}
        {%- assign pays = section.blocks | where: "type", "payment_method" -%}
        {%- if pays.size > 0 -%}
          <div class="agc-pay">
            <span>{{ s.pay_label }}</span>
            {%- for b in pays -%}
              {%- if b.settings.logo -%}
                <img src="{{ b.settings.logo | image_url: width: 120 }}" width="{{ b.settings.logo.width }}" height="{{ b.settings.logo.height }}" loading="lazy" alt="{{ b.settings.name }}">
              {%- else -%}
                <span>{{ b.settings.name }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ============ SPECS (OVERVIEW / DESIGN / INCLUDED) ============ {%- endcomment -%}
  {%- assign ovps = section.blocks | where: "type", "overview_point" -%}
  {%- assign sgroups = section.blocks | where: "type", "spec_group" -%}
  {%- assign incs = section.blocks | where: "type", "included_item" -%}
  {%- assign has_specs = false -%}
  {%- if ovps.size > 0 or sgroups.size > 0 or incs.size > 0 -%}{%- assign has_specs = true -%}{%- endif -%}
  {%- if s.show_specs and has_specs -%}
    <div class="agc-sec alt">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.specs_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.specs_title }}</h2>
        </div>
        {%- if ovps.size > 0 -%}
          <div class="agc-specs-block" style="max-width:760px;margin:0 auto 40px">
            <h3>{{ s.specs_overview_title }}</h3>
            {%- for b in ovps -%}
              <div class="agc-ovp"><span class="ck">✓</span>
                <div><b>{{ b.settings.title }}</b><span>{{ b.settings.description }}</span></div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if sgroups.size > 0 -%}
          <div class="agc-specs-grid">
            {%- for b in sgroups -%}
              <div class="agc-specs-block">
                <div class="agc-spec-title">{{ b.settings.title }}</div>
                <ul class="agc-speclist">
                  {%- assign rows = b.settings.lines | newline_to_br | split: '<br />' -%}
                  {%- for r in rows -%}{%- assign rr = r | strip -%}{%- if rr != blank -%}<li>{{ rr }}</li>{%- endif -%}{%- endfor -%}
                </ul>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if incs.size > 0 -%}
          <div class="agc-specs-block" style="max-width:760px;margin:32px auto 0">
            <h3>{{ s.specs_included_title }}</h3>
            <ul class="agc-speclist">
              {%- for b in incs -%}<li>{{ b.settings.text }}</li>{%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ MARQUEE ============ {%- endcomment -%}
  {%- assign mq = section.blocks | where: "type", "marquee_item" -%}
  {%- if mq.size > 0 -%}
    <div class="agc-ann" style="margin-top:32px">
      <div class="agc-ann-track">
        {%- for i in (1..2) -%}{%- for b in mq -%}<span>{{ b.settings.text }}</span>{%- endfor -%}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ UGC PHOTO GRID ============ {%- endcomment -%}
  {%- assign ugc_items = section.blocks | where: "type", "ugc_photo" -%}
  {%- if ugc_items.size > 0 -%}
    <div class="agc-sec">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.ugc_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.ugc_title }}</h2>
        </div>
        <div class="agc-ugc-grid">
          {%- for b in ugc_items -%}
            <div class="agc-ugc-card{% if forloop.index > 8 %} agc-ugc-hidden{% endif %}" data-ugc>
              {%- if b.settings.photo -%}
                <img src="{{ b.settings.photo | image_url: width: 600 }}" loading="lazy" alt="{{ b.settings.name | escape }}">
                <div class="agc-ugc-overlay">
                  <span class="agc-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                  {%- if b.settings.quote != blank -%}<p class="agc-ugc-quote">{{ b.settings.quote | truncate: 100 }}</p>{%- endif -%}
                  {%- if b.settings.name != blank -%}<div class="agc-ugc-author">&mdash; {{ b.settings.name }}{% if b.settings.location != blank %}, {{ b.settings.location }}{% endif %}</div>{%- endif -%}
                </div>
              {%- else -%}
                <div class="agc-ugc-ph"></div>
                <div class="agc-ugc-inline">
                  <span class="agc-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                  {%- if b.settings.quote != blank -%}<p class="agc-ugc-quote">&ldquo;{{ b.settings.quote }}&rdquo;</p>{%- endif -%}
                  {%- if b.settings.name != blank -%}<div class="agc-ugc-author">&mdash; {{ b.settings.name }}{% if b.settings.location != blank %}, {{ b.settings.location }}{% endif %}</div>{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if ugc_items.size > 8 -%}
          <button class="agc-ugc-more" onclick="agcUgcMore_{{ uid }}(this)">{{ s.ugc_more_label | default: "Ver más resultados" }}</button>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ FEATURE CARDS ============ {%- endcomment -%}
  {%- assign fcards = section.blocks | where: "type", "feature_card" -%}
  {%- if fcards.size > 0 -%}
    <div class="agc-sec">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.feat_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.feat_title }}</h2>
        </div>
        <div class="agc-features">
          {%- for b in fcards -%}
            <div class="agc-fcard">
              {%- if b.settings.icon_img -%}<img src="{{ b.settings.icon_img | image_url: width: 120 }}" width="{{ b.settings.icon_img.width }}" height="{{ b.settings.icon_img.height }}" loading="lazy" alt="">
              {%- else -%}<div class="ic">{{ b.settings.icon }}</div>{%- endif -%}
              <h3>{{ b.settings.title }}</h3>
              <p>{{ b.settings.description }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ PROBLEM ("TU AGUA NO ES SEGURA") ============ {%- endcomment -%}
  {%- assign pstats = section.blocks | where: "type", "problem_stat" -%}
  {%- if s.show_problem and pstats.size > 0 -%}
    <div class="agc-sec dark">
      <div class="agc-wrap">
        <div class="agc-problem-grid">
          <div class="agc-problem-img">
            {%- if s.prob_image -%}
              <img src="{{ s.prob_image | image_url: width: 900 }}" width="{{ s.prob_image.width }}" height="{{ s.prob_image.height }}" loading="lazy" alt="">
            {%- endif -%}
          </div>
          <div>
            <p class="eyebrow">{{ s.prob_eyebrow }}</p>
            <h2 class="agc-sec-title" style="text-align:left">{{ s.prob_title }}</h2>
            {%- if s.prob_intro != blank -%}<p class="agc-problem-intro">{{ s.prob_intro }}</p>{%- endif -%}
            {%- for b in pstats -%}
              <div class="agc-pstat">
                <div class="agc-pstat-num">{{ b.settings.number }}</div>
                <div class="agc-pstat-label">{{ b.settings.label }}</div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ CAUSES ("LO QUE CAUSA EL AGUA SIN FILTRAR") ============ {%- endcomment -%}
  {%- assign causes = section.blocks | where: "type", "cause_card" -%}
  {%- if causes.size > 0 -%}
    <div class="agc-sec">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.causes_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.causes_title }}</h2>
        </div>
        <div class="agc-causes">
          {%- for b in causes -%}
            <div class="agc-cause">
              <div class="agc-cause-img">
                {%- if b.settings.image -%}<img src="{{ b.settings.image | image_url: width: 500 }}" width="{{ b.settings.image.width }}" height="{{ b.settings.image.height }}" loading="lazy" alt="">{%- endif -%}
              </div>
              <div class="agc-cause-body">
                <h3>{{ b.settings.title }}</h3>
                <p>{{ b.settings.description }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ BENEFITS ("YOU'LL EXPERIENCE") ============ {%- endcomment -%}
  {%- assign benefits = section.blocks | where: "type", "benefit" -%}
  {%- if benefits.size > 0 -%}
    <div class="agc-sec alt">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.ben_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.ben_title }}</h2>
        </div>
        <div class="agc-benefits">
          {%- for b in benefits -%}
            <div class="agc-benefit">
              {%- if b.settings.icon_img -%}<img src="{{ b.settings.icon_img | image_url: width: 140 }}" width="{{ b.settings.icon_img.width }}" height="{{ b.settings.icon_img.height }}" loading="lazy" alt="">
              {%- else -%}<div class="ic">{{ b.settings.emoji }}</div>{%- endif -%}
              <h3>{{ b.settings.title }}</h3>
              <p>{{ b.settings.description }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ STATS ============ {%- endcomment -%}
  {%- assign stats = section.blocks | where: "type", "stat" -%}
  {%- if stats.size > 0 -%}
    <div class="agc-sec accent">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <h2 class="agc-sec-title">{{ s.stat_title }}</h2>
        </div>
        <div class="agc-stats">
          {%- for b in stats -%}
            <div><div class="agc-stat-num">{{ b.settings.number }}</div>
              <div class="agc-stat-label">{{ b.settings.label }}</div></div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ ENDORSEMENT / AVAL ============ {%- endcomment -%}
  {%- if s.show_aval -%}
    <div class="agc-sec">
      <div class="agc-wrap">
        <div class="agc-aval">
          <div class="agc-aval-img">
            {%- if s.av_image -%}<img src="{{ s.av_image | image_url: width: 600 }}" width="{{ s.av_image.width }}" height="{{ s.av_image.height }}" loading="lazy" alt="{{ s.av_name | escape }}">{%- endif -%}
          </div>
          <div>
            {%- if s.av_eyebrow != blank -%}<p class="eyebrow">{{ s.av_eyebrow }}</p>{%- endif -%}
            <h2>{{ s.av_title }}</h2>
            {%- if s.av_quote != blank -%}<p class="agc-aval-quote">“{{ s.av_quote }}”</p>{%- endif -%}
            {%- if s.av_name != blank -%}<div class="agc-aval-name">{{ s.av_name }}</div>{%- endif -%}
            {%- if s.av_role != blank -%}<div class="agc-aval-role">{{ s.av_role }}</div>{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ COMPARISON ============ {%- endcomment -%}
  {%- assign cmp = section.blocks | where: "type", "comparison_row" -%}
  {%- if cmp.size > 0 -%}
    <div class="agc-sec">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.cmp_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.cmp_title }}</h2>
        </div>
        <div class="agc-cmp">
          <div class="agc-cmp-head">
            <div class="f">{{ s.cmp_feature_head }}</div>
            <div class="us">{{ s.cmp_col1 }}</div>
            <div class="them">{{ s.cmp_col2 }}</div>
          </div>
          {%- for b in cmp -%}
            <div class="agc-cmp-row">
              <div class="f"><b>{{ b.settings.feature }}</b><span>{{ b.settings.sub }}</span></div>
              <div class="us">{% if b.settings.col1_yes %}<span class="agc-yes">✓</span>{% else %}<span class="agc-no">✕</span>{% endif %}</div>
              <div class="them">{% if b.settings.col2_yes %}<span class="agc-yes">✓</span>{% else %}<span class="agc-no">✕</span>{% endif %}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ FILTER LAYERS (TABS) ============ {%- endcomment -%}
  {%- assign layers = section.blocks | where: "type", "filter_layer" -%}
  {%- if layers.size > 0 -%}
    <div class="agc-sec alt">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.ft_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.ft_title }}</h2>
          {%- if s.ft_subtitle != blank -%}<p class="agc-sec-sub">{{ s.ft_subtitle }}</p>{%- endif -%}
        </div>
        <div class="agc-tabs">
          {%- for b in layers -%}
            <button type="button" class="agc-tab {% if forloop.first %}is-active{% endif %}"
                    onclick="agcTab_{{ uid }}({{ forloop.index0 }})">{{ b.settings.tab_name }}</button>
          {%- endfor -%}
        </div>
        {%- for b in layers -%}
          <div class="agc-layer {% if forloop.first %}is-active{% endif %}" data-layer="{{ forloop.index0 }}">
            {%- if b.settings.layer_badge != blank -%}<span class="agc-layer-badge">{{ b.settings.layer_badge }}</span>{%- endif -%}
            <h3>{{ b.settings.tab_name }}</h3>
            {%- if b.settings.color_hint != blank -%}<div class="hint">{{ b.settings.color_hint }}</div>{%- endif -%}
            <p>{{ b.settings.description }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ BEFORE / AFTER ============ {%- endcomment -%}
  {%- assign bas = section.blocks | where: "type", "before_after" -%}
  {%- if bas.size > 0 -%}
    <div class="agc-sec alt">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.ba_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.ba_title }}</h2>
        </div>
        <div class="agc-ba-grid">
          {%- for b in bas -%}
            <div class="agc-ba">
              <figure><span>{{ s.ba_before_label }}</span>
                {%- if b.settings.before_image -%}<img src="{{ b.settings.before_image | image_url: width: 700 }}" width="{{ b.settings.before_image.width }}" height="{{ b.settings.before_image.height }}" loading="lazy" alt="">{%- else -%}<div class="ph"></div>{%- endif -%}
              </figure>
              <figure><span>{{ s.ba_after_label }}</span>
                {%- if b.settings.after_image -%}<img src="{{ b.settings.after_image | image_url: width: 700 }}" width="{{ b.settings.after_image.width }}" height="{{ b.settings.after_image.height }}" loading="lazy" alt="">{%- else -%}<div class="ph"></div>{%- endif -%}
              </figure>
            </div>
          {%- endfor -%}
        </div>
        {%- if s.ba_note != blank -%}<p class="agc-ba-note">{{ s.ba_note }}</p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ VIDEO TESTIMONIALS ============ {%- endcomment -%}
  {%- assign vids = section.blocks | where: "type", "video_item" -%}
  {%- if vids.size > 0 -%}
    <div class="agc-sec">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.vid_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.vid_title }}</h2>
        </div>
        <div class="agc-videos">
          {%- for b in vids -%}
            <div class="agc-video">
              {%- if b.settings.video != blank -%}
                {{ b.settings.video | video_tag: image_size: "400x", loop: true, controls: true, muted: true }}
              {%- elsif b.settings.poster -%}
                <img src="{{ b.settings.poster | image_url: width: 500 }}" width="{{ b.settings.poster.width }}" height="{{ b.settings.poster.height }}" loading="lazy" alt="">
                <div class="play"><span>▶</span></div>
              {%- else -%}
                <div class="play"><span>▶</span></div>
              {%- endif -%}
              {%- if b.settings.label != blank -%}<div class="vlabel">{{ b.settings.label }}</div>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ TESTIMONIALS ============ {%- endcomment -%}
  {%- assign tcards = section.blocks | where: "type", "testimonial" -%}
  {%- if tcards.size > 0 -%}
    <div class="agc-sec">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.tc_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.tc_title }}</h2>
        </div>
        <div class="agc-tcards">
          {%- for b in tcards -%}
            <div class="agc-tcard">
              <div class="agc-tcard-top">
                <div class="agc-tcard-av">{{ b.settings.avatar_emoji }}</div>
                <div><div class="agc-tcard-name">{{ b.settings.name }}</div>
                  <div class="agc-tcard-role">{{ b.settings.role }}</div></div>
              </div>
              <span class="agc-stars">★★★★★</span>
              <p>“{{ b.settings.quote }}”</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ FAQ ============ {%- endcomment -%}
  {%- assign faqs = section.blocks | where: "type", "faq_item" -%}
  {%- if faqs.size > 0 -%}
    <div class="agc-sec alt">
      <div class="agc-wrap">
        <div class="agc-sec-head">
          <p class="eyebrow">{{ s.faq_eyebrow }}</p>
          <h2 class="agc-sec-title">{{ s.faq_title }}</h2>
        </div>
        <div class="agc-faq">
          {%- for b in faqs -%}
            <div class="agc-faq-item">
              <button type="button" class="agc-faq-q" onclick="agcFaq_{{ uid }}(this)">
                {{ b.settings.question }}<span class="pm">+</span>
              </button>
              <div class="agc-faq-a"><div class="agc-faq-a-inner">{{ b.settings.answer }}</div></div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
  {%- comment -%} ============ STICKY ADD TO CART ============ {%- endcomment -%}
  {%- if s.show_sticky and product and product.available -%}
    <div id="agc-{{ uid }}-sticky">
      <div class="in">
        <span class="nm">{{ product.title }}</span>
        <span class="pr">{{ product.selected_or_first_available_variant.price | money }}</span>
        <button type="button" onclick="agcStickyAdd_{{ uid }}()">{{ s.cta_text }}</button>
      </div>
    </div>
  {%- endif -%}

</div>

<script>
(function(){
  var uid = "{{ uid }}";
  // gallery
  window["agcThumb_"+uid] = function(el){
    var root = el.closest("#agc-"+uid);
    root.querySelectorAll(".agc-thumb").forEach(function(t){t.classList.remove("is-active");});
    el.classList.add("is-active");
    root.querySelector("#agc-main-"+uid).src = el.getAttribute("data-full");
  };
  // pack selector (real variants) -> toggle active card on change
  (function(){
    var root = document.querySelector("#agc-"+uid);
    if(!root) return;
    root.querySelectorAll(".agc-tier input[type=radio]").forEach(function(r){
      r.addEventListener("change", function(){
        root.querySelectorAll(".agc-tier").forEach(function(t){t.classList.remove("is-active");});
        if(r.checked){ var card = r.closest(".agc-tier"); if(card) card.classList.add("is-active"); }
      });
    });
  })();
  // qty stepper
  window["agcQty_"+uid] = function(d){
    var inp = document.querySelector("#agc-qty-"+uid);
    var v = Math.max(1,(parseInt(inp.value,10)||1)+d);
    inp.value = v;
  };
  // tabs
  window["agcTab_"+uid] = function(i){
    var root = document.querySelector("#agc-"+uid);
    root.querySelectorAll(".agc-tab").forEach(function(t,idx){t.classList.toggle("is-active",idx===i);});
    root.querySelectorAll(".agc-layer").forEach(function(l){l.classList.toggle("is-active",parseInt(l.getAttribute("data-layer"),10)===i);});
  };
  // faq
  window["agcFaq_"+uid] = function(btn){
    var item = btn.parentElement;
    var a = item.querySelector(".agc-faq-a");
    var open = item.classList.toggle("is-open");
    a.style.maxHeight = open ? a.scrollHeight + "px" : "0";
  };
  // AJAX add to cart (progressive enhancement; falls back to normal POST)
  var form = document.querySelector("#agc-form-"+uid);
  if(form){
    form.addEventListener("submit", function(e){
      if(!window.fetch) return; // let normal form POST happen
      e.preventDefault();
      var btn = document.querySelector("#agc-cta-"+uid);
      var original = btn ? btn.textContent : "";
      if(btn){ btn.disabled = true; btn.textContent = "Agregando..."; }
      fetch("{{ routes.cart_add_url }}", {
        method:"POST",
        headers:{ "Accept":"application/json" },
        body:new FormData(form)
      }).then(function(r){ return r.json(); })
        .then(function(){ window.location.href = "{{ routes.cart_url }}"; })
        .catch(function(){ form.submit(); })
        .finally(function(){ if(btn){ btn.disabled=false; btn.textContent=original; } });
    });
  }
  // sticky add-to-cart: trigger main form; show after hero scrolls out
  window["agcStickyAdd_"+uid] = function(){
    var cta = document.querySelector("#agc-cta-"+uid);
    if(cta){ cta.click(); }
  };
  (function(){
    var bar = document.querySelector("#agc-"+uid+"-sticky");
    var hero = document.querySelector("#agc-form-"+uid);
    if(!bar || !hero || !("IntersectionObserver" in window)) return;
    new IntersectionObserver(function(ents){
      ents.forEach(function(en){ bar.classList.toggle("show", !en.isIntersecting); });
    }, { rootMargin:"0px 0px -80% 0px" }).observe(hero);
  })();
  // animated count-up for stat numbers
  (function(){
    var root = document.querySelector("#agc-"+uid);
    if(!root || !("IntersectionObserver" in window)) return;
    var nodes = root.querySelectorAll(".agc-stat-num, .agc-pstat-num");
    var io = new IntersectionObserver(function(ents){
      ents.forEach(function(en){
        if(!en.isIntersecting) return;
        var el = en.target; io.unobserve(el);
        var raw = el.textContent.trim();
        var m = raw.match(/^(\D*)(\d+)(.*)$/);
        if(!m){ return; }
        var pre=m[1], target=parseInt(m[2],10), suf=m[3], start=null, dur=1100;
        function step(ts){ if(!start) start=ts; var p=Math.min((ts-start)/dur,1);
          el.textContent = pre + Math.floor(p*target) + suf; if(p<1) requestAnimationFrame(step); }
        requestAnimationFrame(step);
      });
    }, { threshold:0.4 });
    nodes.forEach(function(n){ io.observe(n); });
  
  // ugc show more
  window["agcUgcMore_"+uid] = function(btn){
    var root = document.querySelector("#agc-"+uid);
    root.querySelectorAll(".agc-ugc-hidden").forEach(function(c){ c.classList.remove("agc-ugc-hidden"); });
    btn.style.display = "none";
  };
})();
})();
</script>

